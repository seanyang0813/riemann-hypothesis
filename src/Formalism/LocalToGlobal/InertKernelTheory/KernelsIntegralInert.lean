      IntegralMv (g.pt (∑ j ∈ s, MvPowerSeries.C (c j) * g.lg (Xv j)) : MvPowerSeries (Fin r) ℂ_[p]) := by
  classical
  have hX : ∀ j : Fin r, MvPowerSeries.constantCoeff (Xv j : MvPowerSeries (Fin r) ℂ_[p]) = 0 := fun j => by simp
  have hT : ∀ t : Finset (Fin r),
