  exact ⟨g₁, e, σ, γ, B', σp, hI, hσ, hF', hσp,
    hF D cc δ B hcc hδ p h5 hj lam ι hι g₁ hI.1 hI.2.1 hI.2.2.1 σ hσ γ B' hF' σp hσp⟩

