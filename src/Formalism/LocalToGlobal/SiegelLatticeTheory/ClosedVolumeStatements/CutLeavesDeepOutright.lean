    ({l : MP p | TieN.IntLow (M p) l} ×ˢ (MulOpposite.op '' {l : MP p | TieN.IntLow (M p) l})) ×ˢ
      ({l : MP p | TieN.IntUp (M p) l} ×ˢ (MulOpposite.op '' {l : MP p | TieN.IntUp (M p) l}))
