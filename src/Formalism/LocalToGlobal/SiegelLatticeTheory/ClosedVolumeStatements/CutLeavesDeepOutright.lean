    rw [SpanOmPf.hsw', (PI.UnitaryGroupMassFormula.BetaLUniq.mem_orth (VS D)).1 hm u (key u hu), star_zero])
  obtain ⟨y, hy, s, hs, rfl⟩ := Submodule.mem_sup.1 hmU
  obtain ⟨x', hx', w, hw, rfl⟩ := Submodule.mem_sup.1 hy
