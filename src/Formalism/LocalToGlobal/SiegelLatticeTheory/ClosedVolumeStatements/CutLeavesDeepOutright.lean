    have hx2 := ((mem_KP M).1 hx).2
    have hy := (mem_KP M).1 ((KP M p).inv_mem hx)
    exact ⟨⟨hx1, _, hy.1, rfl⟩, hx2, _, hy.2, rfl⟩
