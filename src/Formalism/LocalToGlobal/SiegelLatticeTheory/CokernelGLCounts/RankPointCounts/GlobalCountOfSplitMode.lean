  · rintro ⟨Y, hY, he⟩
    set u := (sharpEquiv H t (unit_gramHU H hg)).symm Y with hu
    have hYu : sharpEquiv H t (unit_gramHU H hg) u = Y := by rw [hu, LinearEquiv.apply_symm_apply]
    have hX : (u : V) ∈ H.perp (H.X t.f') := by
      rw [mem_perpX_iff]
