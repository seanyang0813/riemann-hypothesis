    (Corank.finrank_VS D) (Corank.tu_ne_zero u) hpS.1 hpS.2 hv''
  have e : v' = w := sub_eq_zero.1 (q1 _ (Submodule.sub_mem _ hv'.1 hw.1) fun a => by
    rw [map_sub, hv'.2, hw.2, sub_self])
  subst e
