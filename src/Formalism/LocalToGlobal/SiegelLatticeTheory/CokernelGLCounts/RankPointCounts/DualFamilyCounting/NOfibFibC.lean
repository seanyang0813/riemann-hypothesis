  obtain ⟨y', hy', ey⟩ := Formalism.L2.SG.NGCut.LeadingMinorIntegrality.star_mem_pow _ y hy
  exact (FractionalIdeal.mem_coeIdeal _).2 ⟨y', hy', ey⟩

