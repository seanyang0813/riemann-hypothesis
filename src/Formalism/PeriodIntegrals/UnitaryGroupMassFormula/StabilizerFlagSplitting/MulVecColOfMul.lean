  have := congrFun (h j) i
  simpa [mulVec, dotProduct, Matrix.mul_apply] using this

lemma mulVec_col_of_mul {m : Type*} [Fintype m] (k r : ℕ) (A : B.Mat k r)
    (C : Matrix (Fin (2 * r + k + 1)) m ℂ) (h : A * C = C) (j : m) :
