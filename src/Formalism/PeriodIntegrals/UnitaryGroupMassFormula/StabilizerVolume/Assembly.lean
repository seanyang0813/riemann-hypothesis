    rw [tsum_congr hδ, ENNReal.tsum_mul_right, ENNReal.tsum_comm, hrep, cntN]
  calc ∫⁻ k, cfun Γ A y0 (s * (k : G)) * ρ ((s * (k : G))⁻¹) ∂μ'
      = ∫⁻ k, F k ∂μ' := h1
    _ = ∑' δ : (Γ ⊓ H).subgroupOf H, ∫⁻ k in 𝓕', F (δ • k) ∂μ' :=
      h𝓕'.lintegral_eq_tsum'' F
