  funext i j
  simp [gramR, gramB, hR, Formalism.UG.hform, Matrix.sub_apply, map_add (f := _), add_mul, mul_add,
    Finset.sum_add_distrib] <;> ring

theorem gramB_add_right {F E : Type} [Field F] [Field E] [Algebra F E] (R : Type) [CommRing R]
