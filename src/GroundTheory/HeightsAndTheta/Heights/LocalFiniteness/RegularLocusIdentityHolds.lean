theorem isRadicalAway_iff_isRadical_rabinowitschIdeal (K : Ideal (MvPolynomial ι R))
    (g : MvPolynomial ι R) : IsRadicalAway K g ↔ (rabinowitschIdeal K g).IsRadical := by
