  have hex : ∀ n, ∃ q : (Σ r : ℕ, Fin r → MvPolynomial (Ix κ) ℚ), IsSecBasis d.x n q.2 := fun n => by
    obtain ⟨b, hb⟩ := exists_isSecBasis d.x n
    exact ⟨⟨_, b⟩, hb⟩
  let p : ℕ → (Σ r : ℕ, Fin r → MvPolynomial (Ix κ) ℚ) := fun n => (hex n).choose
