module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Algebra.MvPolynomial.CommRing

@[expose] public section

noncomputable section

namespace ReciprocityTheory.ChartRestriction.G.Chart

open MvPolynomial

section Jet

variable (R : Type) [CommRing R]

abbrev JetR (κ : Type) (m : ℕ) : Type :=
  MvPolynomial κ R ⧸ (Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R))) ^ (m + 1)

/-- Truncation from order `n` to order `m`. -/
def jetTruncate (κ : Type) {m n : ℕ} (h : m ≤ n) : JetR R κ n →ₐ[R] JetR R κ m :=
  Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right (Nat.succ_le_succ h))

def jetTruncR (κ : Type) (m : ℕ) : JetR R κ (m + 1) →ₐ[R] JetR R κ m :=
  jetTruncate R κ (Nat.le_succ m)

def jetZeroR (κ : Type) (m : ℕ) : JetR R κ m →ₐ[R] JetR R κ 0 :=
  jetTruncate R κ (Nat.zero_le m)

variable {R}

abbrev zR {κ : Type} (m : ℕ) (j : κ) : JetR R κ m := Ideal.Quotient.mk _ (MvPolynomial.X j)

variable (R)

theorem span_X_le_ker_aeval_zero (κ : Type) :
    Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R)) ≤
      RingHom.ker (MvPolynomial.aeval (R := R) (fun _ : κ => (0 : R))) := by
  rw [Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  simp

def jetAug (κ : Type) (m : ℕ) : JetR R κ m →ₐ[R] R :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval (fun _ : κ => (0 : R))) (fun a ha =>
    span_X_le_ker_aeval_zero R κ (Ideal.pow_le_self (by omega) ha))

variable {R}

theorem jetAug_zR {κ : Type} (m : ℕ) (j : κ) : jetAug R κ m (zR m j) = 0 := by
  show MvPolynomial.aeval (fun _ : κ => (0 : R)) (MvPolynomial.X j) = 0
  simp

theorem jet_ext {κ : Type} {m : ℕ} {A : Type} [CommRing A] [Algebra R A] {ψ₁ ψ₂ : JetR R κ m →ₐ[R] A}
    (h : ∀ j, ψ₁ (zR (R := R) m j) = ψ₂ (zR (R := R) m j)) : ψ₁ = ψ₂ := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro j
  exact h j


variable (R) in
def jetLift {κ : Type} {m : ℕ} {A : Type} [CommRing A] [Algebra R A] (J : Ideal A) (hJ : J ^ (m + 1) = ⊥)
    (b : κ → A) (hb : ∀ j, b j ∈ J) : JetR R κ m →ₐ[R] A :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval b) (fun a ha => by
    have h1 : Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R)) ≤
        J.comap (MvPolynomial.aeval (R := R) b) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      simpa using hb j
    have h2 : a ∈ (J ^ (m + 1)).comap (MvPolynomial.aeval (R := R) b) :=
      Ideal.le_comap_pow _ (m + 1) (Ideal.pow_right_mono h1 (m + 1) ha)
    rw [hJ] at h2
    exact h2)

theorem jetLift_zR {κ : Type} {m : ℕ} {A : Type} [CommRing A] [Algebra R A] (J : Ideal A)
    (hJ : J ^ (m + 1) = ⊥) (b : κ → A) (hb : ∀ j, b j ∈ J) (j : κ) :
    jetLift (R := R) J hJ b hb (zR m j) = b j := by
  show MvPolynomial.aeval b (MvPolynomial.X j) = b j
  simp

theorem sub_const_mem_span_X {κ : Type} (p : MvPolynomial κ R) :
    p - MvPolynomial.C (MvPolynomial.aeval (fun _ : κ => (0 : R)) p) ∈
      Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R)) := by
  classical
  have hs : Set.range (MvPolynomial.X : κ → MvPolynomial κ R) = MvPolynomial.X '' Set.univ := by
    rw [Set.image_univ]
  rw [hs, MvPolynomial.mem_ideal_span_X_image]
  intro mono hm
  by_contra hcon
  push Not at hcon
  have h0 : mono = 0 := by
    ext i
    exact hcon i (Set.mem_univ i)
  subst h0
  rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_C, if_pos rfl] at hm
  apply hm
  rw [sub_eq_zero, MvPolynomial.aeval_zero', ← MvPolynomial.constantCoeff_eq]
  rfl

/-- Evaluation at the origin has kernel the ideal generated by the variables. -/
theorem ker_aeval_zero_eq_span_X (κ : Type) :
    RingHom.ker (MvPolynomial.aeval (R := R) (fun _ : κ => (0 : R))) =
      Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R)) := by
  refine le_antisymm (fun p hp => ?_) (span_X_le_ker_aeval_zero R κ)
  rw [RingHom.mem_ker] at hp
  simpa only [hp, map_zero, sub_zero] using sub_const_mem_span_X (R := R) p

/-- The augmentation ideal of a jet ring is the image of the ideal of the variables. -/
theorem ker_jetAug_eq_map_span_X (κ : Type) (m : ℕ) :
    RingHom.ker (jetAug R κ m) =
      (Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R))).map (Ideal.Quotient.mk _) := by
  let q : MvPolynomial κ R →+* JetR R κ m := Ideal.Quotient.mk _
  have h : (RingHom.ker (jetAug R κ m)).comap q =
      Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R)) :=
    ker_aeval_zero_eq_span_X (R := R) κ
  change _ = Ideal.map q _
  calc
    _ = Ideal.map q ((RingHom.ker (jetAug R κ m)).comap q) :=
      (Ideal.map_comap_of_surjective q Ideal.Quotient.mk_surjective _).symm
    _ = _ := congrArg (Ideal.map q) h

theorem ker_jetAug_pow (κ : Type) (m : ℕ) : (RingHom.ker (jetAug R κ m)) ^ (m + 1) = ⊥ := by
  rw [ker_jetAug_eq_map_span_X, ← Ideal.map_pow, Ideal.map_quotient_self]

@[simp]
theorem jetTruncate_zR {κ : Type} {m n : ℕ} (h : m ≤ n) (j : κ) :
    jetTruncate R κ h (zR n j) = zR m j := rfl

theorem jetTruncate_surjective (κ : Type) {m n : ℕ} (h : m ≤ n) :
    Function.Surjective (jetTruncate R κ h) := by
  intro y
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨Ideal.Quotient.mk _ p, rfl⟩

@[simp]
theorem jetTruncate_comp (κ : Type) {l m n : ℕ} (hlm : l ≤ m) (hmn : m ≤ n) :
    (jetTruncate R κ hlm).comp (jetTruncate R κ hmn) = jetTruncate R κ (hlm.trans hmn) :=
  jet_ext fun _ => rfl

@[simp]
theorem jetAug_comp_jetTruncate (κ : Type) {m n : ℕ} (h : m ≤ n) :
    (jetAug R κ m).comp (jetTruncate R κ h) = jetAug R κ n :=
  jet_ext fun j => by rw [AlgHom.comp_apply, jetTruncate_zR, jetAug_zR, jetAug_zR]

/-- Truncating to order `m` kills precisely the `(m + 1)`st power of the augmentation ideal. -/
theorem ker_jetTruncate (κ : Type) {m n : ℕ} (h : m ≤ n) :
    RingHom.ker (jetTruncate R κ h) = (RingHom.ker (jetAug R κ n)) ^ (m + 1) := by
  let q : MvPolynomial κ R →+* JetR R κ n := Ideal.Quotient.mk _
  have hker : (RingHom.ker (jetTruncate R κ h)).comap q =
      (Ideal.span (Set.range (MvPolynomial.X : κ → MvPolynomial κ R))) ^ (m + 1) :=
    Ideal.mk_ker
  rw [ker_jetAug_eq_map_span_X, ← Ideal.map_pow]
  change _ = Ideal.map q _
  calc
    _ = Ideal.map q ((RingHom.ker (jetTruncate R κ h)).comap q) :=
      (Ideal.map_comap_of_surjective q Ideal.Quotient.mk_surjective _).symm
    _ = _ := congrArg (Ideal.map q) hker

/-- A uniform nilpotence bound for the kernel of a truncation. -/
theorem ker_jetTruncate_pow_eq_bot (κ : Type) {m n k : ℕ} (h : m ≤ n) (hk : n + 1 ≤ (m + 1) * k) :
    (RingHom.ker (jetTruncate R κ h)) ^ k = ⊥ := by
  rw [ker_jetTruncate, ← pow_mul, ← le_bot_iff]
  exact (Ideal.pow_le_pow_right hk).trans (ker_jetAug_pow (R := R) κ n).le

theorem ker_jetTruncR_sq (κ : Type) (m : ℕ) :
    (RingHom.ker (jetTruncR R κ m)) ^ 2 = ⊥ :=
  ker_jetTruncate_pow_eq_bot (R := R) κ (Nat.le_succ m) (by omega)

theorem ker_jetAug_nil (κ : Type) (m : ℕ) : IsNilpotent (RingHom.ker (jetAug R κ m)) :=
  ⟨m + 1, by rw [ker_jetAug_pow, Ideal.zero_eq_bot]⟩

theorem zR_mem_ker {κ : Type} (m : ℕ) (j : κ) : zR (R := R) m j ∈ RingHom.ker (jetAug R κ m) :=
  jetAug_zR m j

end Jet

section Etale

variable {R : Type} [CommRing R] {n : ℕ} {S : Type} [CommRing S] [Algebra R S]
  [Algebra (MvPolynomial (Fin n) R) S] [IsScalarTower R (MvPolynomial (Fin n) R) S]


variable (R) in
abbrev sX (j : Fin n) : S := algebraMap (MvPolynomial (Fin n) R) S (MvPolynomial.X j)

/-- Over a formally unramified chart, two lifts across a map with nilpotent kernel
are equal if they agree on the coordinates and after reduction. -/
theorem etale_ext [Algebra.FormallyUnramified (MvPolynomial (Fin n) R) S]
    {A B : Type} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]
    (ε : S →ₐ[R] B) (aug : A →ₐ[R] B)
    (hJ : IsNilpotent (RingHom.ker aug)) (φ₁ φ₂ : S →ₐ[R] A) (h1 : aug.comp φ₁ = ε) (h2 : aug.comp φ₂ = ε)
    (hs : ∀ j : Fin n, φ₁ (sX (R := R) (S := S) j) = φ₂ (sX (R := R) (S := S) j)) : φ₁ = φ₂ := by
  let ρ : MvPolynomial (Fin n) R →ₐ[R] A := φ₁.comp (IsScalarTower.toAlgHom R (MvPolynomial (Fin n) R) S)
  have hρ2 : φ₂.comp (IsScalarTower.toAlgHom R (MvPolynomial (Fin n) R) S) = ρ := by
    apply MvPolynomial.algHom_ext
    intro j
    exact (hs j).symm
  let : Algebra (MvPolynomial (Fin n) R) A := ρ.toRingHom.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin n) R) A := IsScalarTower.of_algebraMap_eq (fun r => (ρ.commutes r).symm)
  let ψ₁ : S →ₐ[MvPolynomial (Fin n) R] A :=
    { φ₁.toRingHom with commutes' := fun p => rfl }
  let ψ₂ : S →ₐ[MvPolynomial (Fin n) R] A :=
    { φ₂.toRingHom with commutes' := fun p => AlgHom.congr_fun hρ2 p }
  have hψ : ψ₁ = ψ₂ :=
    Algebra.FormallyUnramified.ext' aug.toRingHom hJ ψ₁ ψ₂
      (fun x => (AlgHom.congr_fun h1 x).trans (AlgHom.congr_fun h2 x).symm)
  exact AlgHom.ext fun x => AlgHom.congr_fun hψ x

/-- Over a formally smooth chart, a lift of the coordinates along a surjection
with nilpotent kernel extends to a lift of the whole chart. -/
theorem exists_lift_with_coordinates [Algebra.FormallySmooth (MvPolynomial (Fin n) R) S]
    {A B : Type} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]
    (ε : S →ₐ[R] B) (aug : A →ₐ[R] B) (haug : Function.Surjective aug)
    (hJ : IsNilpotent (RingHom.ker aug)) (b : Fin n → A) (hb : ∀ j, aug (b j) = ε (sX (R := R) j)) :
    ∃ φ : S →ₐ[R] A, aug.comp φ = ε ∧ ∀ j, φ (sX (R := R) j) = b j := by
  let ρ : MvPolynomial (Fin n) R →ₐ[R] A := MvPolynomial.aeval b
  let σ : MvPolynomial (Fin n) R →ₐ[R] B :=
    ε.comp (IsScalarTower.toAlgHom R (MvPolynomial (Fin n) R) S)
  have hcompat : aug.comp ρ = σ := by
    apply MvPolynomial.algHom_ext
    intro j
    change aug (MvPolynomial.aeval b (MvPolynomial.X j)) = ε (sX R j)
    rw [MvPolynomial.aeval_X]
    exact hb j
  let : Algebra (MvPolynomial (Fin n) R) A := ρ.toRingHom.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin n) R) A :=
    IsScalarTower.of_algebraMap_eq (fun r => (ρ.commutes r).symm)
  let : Algebra (MvPolynomial (Fin n) R) B := σ.toRingHom.toAlgebra
  let aug' : A →ₐ[MvPolynomial (Fin n) R] B :=
    { aug.toRingHom with commutes' := AlgHom.congr_fun hcompat }
  let ε' : S →ₐ[MvPolynomial (Fin n) R] B :=
    { ε.toRingHom with commutes' := fun _ => rfl }
  let φ := Algebra.FormallySmooth.liftOfSurjective ε' aug' haug hJ
  refine ⟨φ.restrictScalars R, ?_, ?_⟩
  · exact AlgHom.ext (Algebra.FormallySmooth.liftOfSurjective_apply ε' aug' haug hJ)
  · intro j
    exact (φ.commutes (MvPolynomial.X j)).trans (MvPolynomial.aeval_X b j)

/-- A formally smooth chart admits lifts along nilpotent augmentations to the base ring. -/
theorem etale_exists [Algebra.FormallySmooth (MvPolynomial (Fin n) R) S]
    (ε : S →ₐ[R] R) {A : Type} [CommRing A] [Algebra R A] (aug : A →ₐ[R] R)
    (hJ : IsNilpotent (RingHom.ker aug)) (b : Fin n → A) (hb : ∀ j, aug (b j) = ε (sX (R := R) j)) :
    ∃ φ : S →ₐ[R] A, aug.comp φ = ε ∧ ∀ j, φ (sX (R := R) j) = b j :=
  exists_lift_with_coordinates ε aug (fun r => ⟨algebraMap R A r, by simp⟩) hJ b hb

end Etale

end ReciprocityTheory.ChartRestriction.G.Chart
