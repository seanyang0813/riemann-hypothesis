      have hm' : (m : 𝓞 D.host.E) ≠ 0 := fun h => hm0 (by exact_mod_cast congrArg (fun z : 𝓞 D.host.E => (z : D.host.E)) h)
      have := (inv_mem_iff Q hm').2 hQ
