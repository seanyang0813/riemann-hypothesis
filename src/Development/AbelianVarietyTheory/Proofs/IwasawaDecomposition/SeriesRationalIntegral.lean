  · set_option synthInstance.maxHeartbeats 100000 in
      simp only [Cover.rd, map_sum, map_smulₛₗ, hb, Finset.smul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [RingHom.id_apply, smul_comm]



