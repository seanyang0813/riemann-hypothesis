  let W := (HW l).W K s LL h
  let E := ((F l).E K s LL h).tie
  let a : AA K LL := W.Q ^ m
  let ξ : RA LL := (1 : ↥(OL LL)) ⊗ₜ[ℤ_[l]] (D.locA l).ξ
