theorem stdBlock_iff (a c : ℕ) (x : Gn p (a + 1 + c)) :
    StdBlock a x ↔ InPar (a + 1) (x : Mt p (a + 1 + c)) ∧ br (a + 1) c (x : Mt p (a + 1 + c)) = 1 ∧
      ∀ i j : Fin (a + 1), (j : ℕ) < a → tl (a + 1) (x : Mt p (a + 1 + c)) i j = if i = j then 1 else 0 := by
