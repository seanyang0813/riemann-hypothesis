    · ext i j
      simp only [br, entN]
      rw [dite_eq_left (by omega), h _ _ (by simp; omega)]
      simp [Matrix.one_apply, Fin.ext_iff]
    · simp only [tl, entN]
      rw [dite_eq_left (by omega), h _ _ (by simp; omega)]
      simp [Fin.ext_iff]
  · rintro ⟨h1, h2, h3⟩ i j hij
    by_cases hi : (i : ℕ) ≤ a
    · have hj : (j : ℕ) < a := by omega
