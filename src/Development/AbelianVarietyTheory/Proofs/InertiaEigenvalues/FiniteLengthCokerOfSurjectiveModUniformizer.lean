  refine ⟨?_, hcd⟩
  rcases lt_trichotomy i j with hij | hij | hij
  · have hx := hlt' i hij
    rw [hi, hcd] at hx
    exact absurd hx (lt_irrefl d)
  · exact hij
  · have hx := hlt j hij
    rw [hj, ← hcd] at hx
    exact absurd hx (lt_irrefl c)

