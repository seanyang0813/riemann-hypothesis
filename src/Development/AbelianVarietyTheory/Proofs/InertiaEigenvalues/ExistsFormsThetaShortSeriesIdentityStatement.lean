    · exact absurd (b1.symm.trans a1) (hne _ _)
    · exact ⟨hc _ _ (a1.symm.trans b1), by omega⟩
  obtain ⟨k1, k2⟩ := key
  rw [k1, Fin.ext k2, hx3, hy3]

