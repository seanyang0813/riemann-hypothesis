  rw [map_add (f := _), PowerSeries.coeff_mul_C, PowerSeries.coeff_mul_X_pow', if_neg (by omega),
    PowerSeries.coeff_X_pow, if_pos rfl, add_zero] at h
  exact hϖ.not_isUnit (IsUnit.of_mul_eq_one_right _ h)

