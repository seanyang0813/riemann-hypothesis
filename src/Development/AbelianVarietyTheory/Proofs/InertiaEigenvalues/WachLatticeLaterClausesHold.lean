    rw [← Ideal.mem_span_singleton, ← hϖ.maximalIdeal_eq]
    exact ha
  by_contra hi
  have main : ∀ (m : ℕ) (y : PowerSeries O), XX l O s ^ H * y ∈ 𝔞 (i + m) →
      y ∈ Ideal.span {PowerSeries.C ϖ, PowerSeries.X ^ (m + 1)} := by
