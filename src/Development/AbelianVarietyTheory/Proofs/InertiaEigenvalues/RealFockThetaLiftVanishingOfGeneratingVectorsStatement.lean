    rwa [Matrix.star_eq_conjTranspose] at this
  have hG : G = (B⁻¹)ᴴ * B⁻¹ := by
    calc G = (B * B⁻¹)ᴴ * G * (B * B⁻¹) := by rw [h1, Matrix.conjTranspose_one, Matrix.one_mul, Matrix.mul_one]
