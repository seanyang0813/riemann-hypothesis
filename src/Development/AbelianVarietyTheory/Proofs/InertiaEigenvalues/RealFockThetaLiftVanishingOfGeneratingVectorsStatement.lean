    exact _root_.GlobalTheory.HoweGen.cvType_mem_of_stable D G Pl0 T A Ks R F hG hF i t U hstab hlie' hio' φ hφ w
  have hN : B j (P - Q) = 0 :=
    hNo (B j) (fun u hu P₁ _ P₂ h l => heq j u hu P₁ P₂ h l) _ hPQ
