  · congr 1
    ext c
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  refine Finset.prod_congr rfl fun v _ => ?_
  dsimp only
  by_cases h : v.1 = P
  · rw [if_pos (Subtype.ext h), if_pos h]
  · rw [if_neg fun e => h (congrArg Subtype.val e), if_neg h]

