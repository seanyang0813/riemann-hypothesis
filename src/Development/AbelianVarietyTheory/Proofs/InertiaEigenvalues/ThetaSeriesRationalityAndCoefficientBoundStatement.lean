  rcases hz with h1 | h1
  · exact h1
  · obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    have hk : z ^ k = z⁻¹ := by
      rw [pow_succ] at h; exact eq_inv_of_mul_eq_one_left h
