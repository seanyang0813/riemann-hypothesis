  unfold offE

  rw [e, RingHom.map_sub, RingHom.map_sub, RingHom.map_one, map_sum, sub_mul, sub_mul, one_mul, h1, Finset.sum_mul,
  Finset.sum_eq_zero h2, sub_zero, sub_zero]


