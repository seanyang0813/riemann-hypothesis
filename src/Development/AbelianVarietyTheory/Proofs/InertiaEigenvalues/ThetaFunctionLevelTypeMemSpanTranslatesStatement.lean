  obtain ⟨P, he, hP⟩ : ∃ P, IsIdemSum e P ∧ ∀ PP, PP ∈ P ↔ PP ∈ R.Pg ∨ PP ∈ R.Q t :=
    ⟨_, he', fun PP => Finset.mem_union⟩
