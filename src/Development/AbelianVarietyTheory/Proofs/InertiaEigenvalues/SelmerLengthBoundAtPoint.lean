    have hπ0 : π ≠ 0 := hπ.ne_zero
    have hmem : ∀ n : ℕ, ∃ yn ∈ LinearMap.range D.j', π ^ n • yn = y := fun n => by
      obtain ⟨yn, hyn⟩ := exists_smul_eq_H1_of_ne_zero D.ρT' (pow_ne_zero n hπ0) y
