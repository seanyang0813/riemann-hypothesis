    (fun c hc a => exists_smul_eq_H1_of_ne_zero D.ρT hc a) (LinearMap.range D.j')
    (Module.Finite.iff_fg.1 inferInstance) (fun w => GlobalTheory.jSpan_holds hO hF i hD w) hnd f
  exact ⟨a, ha⟩

