  let z' : Z1 ρ := ⟨fun g => (algebraMap O (FractionRing O) c)⁻¹ • z.1 g, z.2.1.const_smul _,
    fun g h => by
      show (algebraMap O (FractionRing O) c)⁻¹ • z.1 (g * h) =
        (algebraMap O (FractionRing O) c)⁻¹ • z.1 g + ρ g ((algebraMap O (FractionRing O) c)⁻¹ • z.1 h)
