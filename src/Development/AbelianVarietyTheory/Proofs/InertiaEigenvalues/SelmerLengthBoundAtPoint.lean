  have h1 := LinearMap.congr_fun hM' ⟨c • w, hcw⟩
  simp only [LinearMap.comp_apply, Submodule.subtype_apply, map_smul] at h1
  have h2 : c • (Φ a w - f w) = 0 := by rw [smul_sub, h1, sub_self]
  exact sub_eq_zero.1 (frac_smul_eq_zero hc h2)

