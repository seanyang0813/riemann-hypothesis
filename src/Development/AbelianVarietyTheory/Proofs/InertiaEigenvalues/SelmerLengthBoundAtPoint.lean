  obtain ⟨g, h⟩ := p
  simp only [d1_apply, Submodule.coe_subtype, Pi.add_apply, cupCocycleZ1Z1_apply,
    LinearMap.flip_apply, map_neg, ← hbe, x.2.2 g h, y.2.2 g h, map_add, LinearMap.add_apply]
  abel

