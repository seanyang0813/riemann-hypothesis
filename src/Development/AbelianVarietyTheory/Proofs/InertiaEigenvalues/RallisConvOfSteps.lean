    simp_rw [hnorm]
    rw [hρ, lintegral_prod _ ?_]
    · exact hfin
    · rw [← hρ]
      exact AEMeasurable.tsum fun Y => by
        simpa [hnorm] using (hF Y).enorm
  have hint : ∀ Y, Integrable (F Y) ρ := fun Y =>
    ⟨hF Y, lt_of_le_of_lt (ENNReal.le_tsum (f := fun Y => ∫⁻ p, ‖F Y p‖ₑ ∂ρ) Y)
