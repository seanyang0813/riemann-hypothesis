    obtain ⟨w, hw⟩ := _root_.GlobalTheory.BKLim.exists_gal_ev_E_unit bk (g : GQ l)
    have hP : ((ρ g).map (algebraMap ℤ_[l] (Ainf l))).map WittVector.frobenius =
