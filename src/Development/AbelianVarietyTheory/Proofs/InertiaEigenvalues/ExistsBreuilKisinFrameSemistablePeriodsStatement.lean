theorem map_smul_hom {R S F : Type*} [CommRing R] [CommRing S] [FunLike F R S] [RingHomClass F R S] {m n : Type*}
    (f : F) (c : R) (M : Matrix m n R) : (c • M).map f = f c • M.map f :=
