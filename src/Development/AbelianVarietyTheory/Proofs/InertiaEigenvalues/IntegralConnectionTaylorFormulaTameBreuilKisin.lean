    change _ = μ (E.tr δ (E.tr p₀ x))
    rw [← E.tr_comp, hμx]; rfl) y
  have h1 := semi_ext (E.tr_bc p₁) (k.comp δ.f) G _ hG hν (fun x => by
    change _ = μ (E.tr δ (E.tr p₁ x))
