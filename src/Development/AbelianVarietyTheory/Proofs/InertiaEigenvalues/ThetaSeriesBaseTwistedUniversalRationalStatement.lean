    (hval : ∀ x, (((t.chi * t'.chi) x : Circle) : ℂ) ∈ σ.fieldRange) :
    ∃ δ : Formalism.L2.Host.HChar D.host.E, IsTwist pd σ δ (t.chi * t'.chi) := GlobalTheory.TwistProduct.isTwist_mul D t t' ht ht' hdisj hd pd k σ hord hpd hval


