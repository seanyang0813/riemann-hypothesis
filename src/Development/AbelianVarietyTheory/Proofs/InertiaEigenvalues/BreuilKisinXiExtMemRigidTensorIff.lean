  | zero => simpa [h0] using mul_nonneg (div_nonneg hN hr.le) hρ
  | succ m =>
    have key : ρ ^ (m + 1) * r ≤ r ^ (m + 1) * ρ := by
      have h1 := pow_le_pow_left₀ hρ hρr m
