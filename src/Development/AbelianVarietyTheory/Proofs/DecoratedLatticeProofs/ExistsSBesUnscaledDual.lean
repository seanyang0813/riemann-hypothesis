    (y : AE D) :
    ψ (pairA D.host.F 0 (Algebra.trace (AF D.host.F) (AE D) y).2) = psiEf (tauF (instOf D) (-y)) :=
  fin_char (instOf D) ψ (GlobalTheory.StdRat.stdChar_fin_rat D ψ hψ) (fun _ hβ => GlobalTheory.SplitCharCond.char_int hψ hβ)
