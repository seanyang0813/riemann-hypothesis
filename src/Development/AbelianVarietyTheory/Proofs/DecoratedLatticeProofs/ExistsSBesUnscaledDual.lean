  · have h2 : ¬ (a.1 + 1 = ρ) := by omega
    rw [Finset.sum_eq_single (⟨a.1 + 1, h1⟩ : Fin ρ) (fun b _ hb => if_neg fun e => hb (Fin.ext e))
