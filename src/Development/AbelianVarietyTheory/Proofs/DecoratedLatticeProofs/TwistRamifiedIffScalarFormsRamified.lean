  have hfin : ∀ (f : 𝓀[k]ˣ → GA (I.rec7 l Z) ((I.rec7 l Z).sp.X j) → ℂ) x, (∑ᶠ s, f s) x = ∑ᶠ s, f s x :=
    fun f x => finsum_apply (Set.toFinite _) x
  constructor
  · intro H c
