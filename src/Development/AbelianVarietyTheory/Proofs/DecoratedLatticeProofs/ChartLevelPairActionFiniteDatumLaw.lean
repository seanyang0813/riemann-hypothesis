      have e3 : (((Formalism.L2.Theta.mt T w'⁻¹ * (M : Matrix (Fin T.rank) (Fin S.rank) (AE D)) : Matrix (Fin T.rank) (Fin S.rank) (AE D)) * Formalism.L2.Theta.mt S w : Matrix (Fin T.rank) (Fin S.rank) (AE D))).map (infPart D) = M.map (infPart D) := by
