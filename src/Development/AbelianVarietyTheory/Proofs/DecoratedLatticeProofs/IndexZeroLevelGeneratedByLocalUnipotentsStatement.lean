  intro k _ _ _ _ s κ S x hx
  have mem_J_iff_pattern (g : GL (Fin κ ⊕ Fin (s + 1)) k) :
      g ∈ S.P.J ↔ g ∈ KO k _ ∧ ∀ a b, ¬ FreeTop S.ρ a b →
