      rw [← hg₀, SymPattern.entry_lt_iff, hgb]
      exact SymPattern.pat_of_mul S.ρ u ((Radical.mem_N_iff u).mp hu) γ hγ a b hab
    · rintro ⟨⟨g₀, hg₀⟩, hpat⟩
