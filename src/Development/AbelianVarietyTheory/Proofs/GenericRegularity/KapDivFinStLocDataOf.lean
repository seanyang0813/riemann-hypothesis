theorem exists_embeddings_of_roots {F L : Type} [Field F] [Field L] [Algebra F L]
    (pb : PowerBasis F L) (τ : F →+* ℂ) {n : ℕ} (r : Fin n → ℂ)
    (hr : ∀ z, ((minpoly F pb.gen).map τ).eval z = 0 ↔ ∃ i, r i = z) :
    ∃ P : Fin n → (L →+* ℂ), (∀ k, P k pb.gen = r k) ∧
