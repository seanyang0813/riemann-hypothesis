    (hX : ∀ I, gd I → (X I).IsDG (PI.BesselPeriodGGP.eps48 k r) fun a => lam a + ((ν + eZ I.1) a : ℝ)) :
    ∃ F F', IsFamG lam q0 F ∧ IsFamG lam q0 F' ∧ F ν = R₀ ∧ (∀ I, gd I → F' (ν + eZ I.1) = X I) ∧
