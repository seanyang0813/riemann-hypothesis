  · have hne : ∀ I : Sub (2 * r + k + 1) l, ν ≠ ν + eZ I.1 := fun I h => by
      obtain ⟨a, ha⟩ := Finset.card_pos.1 (by rw [I.2]; omega : 0 < I.1.card)
