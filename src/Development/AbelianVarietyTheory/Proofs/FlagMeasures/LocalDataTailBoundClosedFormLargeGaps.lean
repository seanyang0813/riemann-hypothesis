    · refine ⟨R0, fun hq => ?_, fun _ => rfl⟩
      subst h0
      exact ⟨hR0.1, hR0.2, h / 2, (hfam ν hq).2.2.1, hN1.2.2.2.2⟩
    · by_cases hq : ∑ a, (ν a).natAbs ≤ q0
