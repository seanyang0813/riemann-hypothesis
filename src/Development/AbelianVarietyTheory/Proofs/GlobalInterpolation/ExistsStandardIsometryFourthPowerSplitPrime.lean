  have hnot : ∀ v : HeightOneSpectrum (𝓞 D.host.K), v ≠ 𝔭 → π ∉ v.asIdeal := by
    intro v hv hπ
    apply hv
    have h1 : 𝔭.asIdeal ^ h ≤ v.asIdeal := by
      rw [hh, k.pi_gen q hqp hs, Ideal.span_singleton_le_iff_mem]
      exact hπ
