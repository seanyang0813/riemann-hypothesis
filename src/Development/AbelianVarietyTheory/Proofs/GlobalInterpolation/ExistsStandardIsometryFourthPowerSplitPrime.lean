  have h2 : ‖j (π : K)‖ ^ (-y) * ‖j (π : K)‖ ^ y = 1 := by
    rw [← zpow_add₀ hjπ, neg_add_cancel, zpow_zero]
  calc ‖j x‖ ^ n = ‖j x‖ ^ n * (‖j (π : K)‖ ^ (-y) * ‖j (π : K)‖ ^ y) := by rw [h2, mul_one]
    _ = (‖j x‖ ^ n * ‖j (π : K)‖ ^ (-y)) * ‖j (π : K)‖ ^ y := by ring
    _ = ‖j (π : K)‖ ^ y := by rw [h1, one_mul]

