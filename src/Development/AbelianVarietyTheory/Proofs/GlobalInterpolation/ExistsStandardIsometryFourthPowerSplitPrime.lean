  have hv0 : w.valuation K x ≠ 0 := by simpa using hx
  have hvx : w.valuation K x = WithZero.exp (-y) := by
    rw [hy, neg_neg, WithZero.exp_log hv0]
  have hπ0 : (π : K) ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hπ
