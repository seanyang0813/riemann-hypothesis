  have HC := canonical_of_abelianDeRham _root_.GlobalTheory.abelianDeRham (isDPNilpotent_squareZero hsq) hπ rfl
  obtain ⟨g, hg⟩ := GlobalTheory.AbelianDim.exists_relDim C o.A o.ab
