    _root_.GlobalTheory.DualCon.ZarGlue.zariski_glue S A hA S V g cov (fun i => hasRep_affineOpen A hA (hV i) (g i) (hgV i))
  obtain ⟨inst, hcomm, hD, -⟩ := _root_.GlobalTheory.DualCon.rep_isDual S A B P hR
