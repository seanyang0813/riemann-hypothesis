  haveI := hA.comm
  have hP : (abelian₂ A L).IsLB := LB.isLB_linComb hL _ _
  have hF : Fam A (abelian₂ A L) := ⟨hP, (GlobalTheory.CubeDual.isAdditive_lam _root_.GlobalTheory.SpreadingModels.cubeTheorem_holds hA hL hP).1⟩
