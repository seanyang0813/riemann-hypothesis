    obtain ⟨U, hU, hU'⟩ := h p
    obtain ⟨V, hV, hc⟩ := exists_pull_eq_zero
      (CechPic.pull a.left (cls L hL) - CechPic.pull (1 : Y ⟶ A).left (cls L hL)) p
