  have hrng : ∀ (W : Z₀.affineOpens) (w : Sp (S'.F.obj (op W))), ∃ z₀ ∈ W.1, P'.y (op W) w = k z₀ := by
    intro W w
    obtain ⟨v, rfl⟩ := hsurU (op W) w
    refine ⟨affPt t₀ W v, W.2.range_fromSpec.le ⟨v, rfl⟩, ?_⟩
    rw [← Scheme.Hom.comp_apply, P'.red (op W), Scheme.Hom.comp_apply]
