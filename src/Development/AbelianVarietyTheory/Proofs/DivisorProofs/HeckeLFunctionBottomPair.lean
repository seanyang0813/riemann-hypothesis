      refine Submodule.span_le.2 ?_
      rintro _ ⟨c, hc, rfl⟩
      exact Submodule.subset_span ⟨c, hc, b, hb, rfl⟩
    exact hle hβ
  refine Submodule.subset_span ⟨β * b, hβb, _, single_mem_homL (conj_mem_scaleInv hs hα) i j, ?_⟩
  rw [Matrix.smul_single, smul_eq_mul]
  congr 1
