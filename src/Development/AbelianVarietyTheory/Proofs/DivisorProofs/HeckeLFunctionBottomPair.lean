      funext v; simp
    rw [hf₀.unique (hrd.smul c)]
    unfold IsSphOff
    rw [hP]
    exact ⟨fun u hu => by rw [GlobalTheory.LatVac.heisO_smul, hf.2.lat.1 u hu],
      fun e he u hu hh => by rw [GlobalTheory.LatVac.heisO_smul, hf.2.lat.2 e he u hu hh]⟩

