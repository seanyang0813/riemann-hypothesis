    (fun o M hM => Submodule.smul_mem _ o hM) (fun α hα β hβ b hb i j => ?_) fun i j => hI (entries_of_span hz i j)
  have hβb : β * b ∈ GlobalTheory.InertSign.Iid D D.host.ccK := by
