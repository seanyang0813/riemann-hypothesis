  apply MorphismProperty.RespectsIso.mk
  · intro X Y Z e f hf
    change IsClosed _
    rw [range_iso_comp]
    exact hf
  · intro X Y Z e f hf
    change IsClosed _
    have : Set.range (f ≫ e.hom).base = e.hom.base '' Set.range f.base := by
      rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp]
    rw [this]
    exact e.hom.isClosedMap _ hf

