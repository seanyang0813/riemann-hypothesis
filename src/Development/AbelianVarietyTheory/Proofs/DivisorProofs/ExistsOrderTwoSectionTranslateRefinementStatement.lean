    rw [← map_mul φ s s]
    exact (congrArg IsUnit ((congrArg φ e').trans hr)).mpr a'.isUnit)
  refine ⟨hu.unit, Units.ext ?_⟩
  show (jK R).appTop.hom (φ s) = _
  rw [nat, hs, hk]

