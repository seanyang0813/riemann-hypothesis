    {b'' : Module.Basis (Fin n'') (LetA ↥(OL LL) (Module.finrank ℚ_[l] ↥(K0 K))) ↥(((HW l).W K 1 LL hA.2.2).N (latOf r'' hr''))}
    {a : Mx ↥(OL LL) n' n} {ha : Tw r r' a} {a' : Mx ↥(OL LL) n'' n'} {ha' : Tw r' r'' a'} {a'' : Mx ↥(OL LL) n'' n} {ha'' : Tw r r'' a''}
