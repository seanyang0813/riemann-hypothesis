theorem mem_N_iff (x : W.DD T) : x ∈ W.N T ↔ ∀ i, (letE i : LetA O n) • x ∈ W.Nl T i := by
  refine ⟨fun h i => letE_smul_mem W T i h, fun h => ?_⟩
  haveI := neZero_letters W
  have e : (∑ i, letE i : LetA O n) = 1 := Finset.univ_sum_single (1 : LetA O n)
