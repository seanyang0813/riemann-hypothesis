    have hk' := ((mem_Nl_iff W T i _).1 hk).1
    refine van_of_one W T nb hζ hk' ((mem_smul_iff W T nb _ _ hk').2 fun j => ?_)
    have hle : W.Nl T i ≤ W.N T := fun x hx => ((mem_Nl_iff W T i _).1 hx).1
