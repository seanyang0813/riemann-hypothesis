theorem van_letE_iff {ι : Type} [Fintype ι] (nb : Module.Basis ι (LetA O n) ↥(W.N T))
    {i : ZMod n} {ζ : LL} (hζ : QRoot W i ζ) {x : W.DD T} (hx : ∃ k : ℕ, W.Q ^ k • x ∈ W.N T) :
    Van W T i ζ ((letE i : LetA O n) • x) ↔ Van W T i ζ x := by
