    have := geom_sum_mul (ζ ^ PD.p ^ (W.s - 1)) PD.p
    rw [← pow_mul, ← pow_succ, ← hs, hp.pow_eq_one, sub_self] at this
    exact (mul_eq_zero.1 this).resolve_right (sub_ne_zero.2 h1)

