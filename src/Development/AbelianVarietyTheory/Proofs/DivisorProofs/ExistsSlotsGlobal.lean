theorem mapMat_mul {n n' n'' : ℕ} {r : ↥(GK K) →* GL (Fin n) ↥(OL LL)} {r' : ↥(GK K) →* GL (Fin n') ↥(OL LL)}
    {r'' : ↥(GK K) →* GL (Fin n'') ↥(OL LL)} {hr : Cont r} {hr' : Cont r'} {hr'' : Cont r''}
