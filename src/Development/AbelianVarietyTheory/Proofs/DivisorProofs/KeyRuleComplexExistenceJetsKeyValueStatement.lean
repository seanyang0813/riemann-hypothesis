    have := FJ.dot_split σ (cv Nn) P
    rw [Exp.leftComponent_intCast, Exp.secondBlock_intCast, ← hy] at this
    rw [← this, hPdef, dotProduct_smul, perV, dotProduct_add, smul_eq_mul]; push_cast; rfl
