  have hkx : ((m ^ 2 : ℕ) : ℂ) • zP σ P = perV d.τ (zP σ M) (zP σ Nn) + d.t12 *ᵥ co bX y := by
    have : ((m ^ 2 : ℕ) : ℂ) • zP σ P = zP σ (perV (d.full σ 0) M Nn) := by
