theorem norm_thT_le_corners {k : ℕ} (τ : Matrix (Fin k) (Fin k) ℂ) (a b Z W : Fin k → ℂ) (n : Fin k → ℤ) (s : ℂ)
    (hs : ‖s‖ ≤ 2) :
    ‖thT τ a b (Z + s • W) n‖ ≤ ‖thT τ a b (Z + (2 + 2 * Complex.I) • W) n‖ + ‖thT τ a b (Z + (2 - 2 * Complex.I) • W) n‖ +
