  obtain ⟨H, hH0, hH⟩ := _root_.GlobalTheory.exists_mvPolynomial_lift_of_mem_conductor R R' _ c hc _ hs1
  letI : Fintype (κ ⊕ σ₀) := Fintype.ofFinite _
