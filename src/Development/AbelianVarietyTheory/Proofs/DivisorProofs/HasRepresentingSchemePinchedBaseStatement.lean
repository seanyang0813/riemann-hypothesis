  have key : ∀ G : MvPolynomial (κ ⊕ ν₀) R', π (aeval ξ G) = eval₂ (π.comp φ) (fun s ↦ ψ (P.val s)) G := fun G ↦ by
    rw [aeval_def, eval₂_comp_left]
