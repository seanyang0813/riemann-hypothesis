    (g' : M.Z.presheaf.stalk x →+* V') (hinj : Function.Injective h) (hirr : Irreducible (h T.ϖ))
    (hsq : spMap g' ≫ M.Z.fromSpecStalk x = spMap h ≫ ξ) (a : M.Z.presheaf.stalk x) (q : ℕ)
