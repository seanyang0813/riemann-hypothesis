  haveI : IsMonHom e.hom := PullGtPf.isMonHom_of_grpPullback hp (isGrpPullback_pullback H s) (𝟙 H) e.hom
    (by simp [e])
  exact GlobalTheory.isSemiAbelian_of_grpIso e (IsSemiAbelian.pullback s H hH)

