  | zero => simpa using (rel_one (σ := σ) (S := S))
  | succ k ih =>
    rw [pow_succ, pow_succ, Nat.mul_succ]
    exact rel_mul ih h

theorem rel_prod_pow {ι : Type} (s : Finset ι) (F G : ι → MvPowerSeries σ S) (β : ι → ℕ)
