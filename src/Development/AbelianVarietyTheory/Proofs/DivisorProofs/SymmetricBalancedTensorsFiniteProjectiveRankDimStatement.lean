    intro 𝔭
    unfold eigRank
    exact (Submodule.finrank_le _).trans (by simp)
  have hset : {𝔭 : PrimeSpectrum R | eigRank (algebraMap R 𝔭.asIdeal.ResidueField) A χ = N} =
