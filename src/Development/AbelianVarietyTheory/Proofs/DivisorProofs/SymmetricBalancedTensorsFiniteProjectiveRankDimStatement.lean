  set bO := RingOfIntegers.basis E
  set bE := integralBasis E
  have hnd := _root_.traceForm_nondegenerate ℚ E
  obtain ⟨d, hd⟩ : ∃ d, d = (Algebra.traceForm ℚ E).dualBasis hnd bE := ⟨_, rfl⟩
