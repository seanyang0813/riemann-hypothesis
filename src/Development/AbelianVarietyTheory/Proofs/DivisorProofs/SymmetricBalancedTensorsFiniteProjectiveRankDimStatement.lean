    fun i => GlobalTheory.FactorDepth.isTanAtG_map Y.t ψ (hv i)
  have hbK := he.2 K ψ
  have hAK : ∀ a i, IsCombAtG Y.t (spMap ψ ≫ chart U) (fun j => spMap (dualMap ψ) ≫ v j) ((A a).map ψ i)
