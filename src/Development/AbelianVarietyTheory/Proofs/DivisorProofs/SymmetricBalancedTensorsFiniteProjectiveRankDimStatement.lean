    conv_lhs => rw [← bO.sum_repr x]
    exact (map_sum Aa _ _).trans (Finset.sum_congr rfl fun j _ => map_zsmul Aa _ _)
  refine ⟨_, inferInstance, fun i => g (d i), bO, ?_, ?_⟩

  · simp_rw [hg, ← map_mul, ← map_sum, ← hbE, hA, map_one]
  · intro a
