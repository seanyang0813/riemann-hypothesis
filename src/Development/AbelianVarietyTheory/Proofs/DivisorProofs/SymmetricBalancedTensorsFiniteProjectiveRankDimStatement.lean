theorem embR_sep {E : Type} [Field E] [NumberField E] (F : IntermediateField ℚ ℂ)
    (hF : ∀ (τ : E →+* ℂ) (a : E), τ a ∈ F) {R : Type} [CommRing R] (iF : F →+* R) (σ τ : E →+* ℂ) (h : σ ≠ τ) :
