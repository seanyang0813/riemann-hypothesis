    (ψ : R →+* K) (φ : c.F →+* K) (hφ : spMap ψ ≫ x ≫ Z.s = spMap (φ.comp β)) :
    ∃ V : Submodule K (Fin g → K), Module.finrank K V = Dw.mult τ ∧
      ∀ (cf : Fin g → K) (w : Sp (DualNumber K) ⟶ Z.t.G.left),
        IsCombAtG Z.t (spMap ψ ≫ x) (fun i => spMap (dualMap ψ) ≫ e i) cf w →
