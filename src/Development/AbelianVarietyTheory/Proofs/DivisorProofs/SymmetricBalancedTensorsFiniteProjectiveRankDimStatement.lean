    (hA : ∀ a i, IsCombAtG Y.t (chart U) v (A a i) (v i ≫ (Y.t.act.act a).left)) (K : Type) [Field K]
    (ψ : Γ(Y.X, U.1) →+* K) (τ : E →+* ℂ) :
    eigRank ψ A (embR c.F c.conj (fnHom Y.s U.1) τ) = Dw.mult τ := by
