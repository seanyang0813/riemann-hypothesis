    (IsLocalRing.isUnit_or_isUnit_one_sub_self (x : O)).imp (u x) (u (1 - x))
  let a' : K →ₐ[k] A := f.rangeRestrict.comp Algebra.TensorProduct.includeLeft
  let b' : K →ₐ[k] A := f.rangeRestrict.comp Algebra.TensorProduct.includeRight
