  let A := f.range
  have : Module.Finite k A := Module.Finite.of_surjective f.rangeRestrict.toLinearMap f.rangeRestrict_surjective
  have : IsArtinianRing A := IsArtinianRing.of_finite k A
  have u : ∀ x : A, IsUnit (x : O) → IsUnit x := fun x hx =>
