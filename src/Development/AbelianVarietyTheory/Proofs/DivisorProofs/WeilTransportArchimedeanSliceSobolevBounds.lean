  | succ i ih =>
    obtain ⟨e1, e2⟩ := ih
    have hd : Differentiable ℝ (fun x =>
        word F ψ (List.replicate i (0, u) ++ vs.map fun v => (v, 0)) Φ (GlobalTheory.WeilCont.adeleJoin F x y)) := by
