    refine ⟨?_, (hc.pow (i + 1)).mul h2⟩
    funext x
    rw [List.replicate_succ, List.cons_append, word_cons, _root_.GlobalTheory.WeilL2Words.dS_adeleJoin_eq F κ ψ ℓ hψ _ y hd (0, u) x]
