    (congrArg (· ≫ _) (Spec.map_id _)).trans (Category.id_comp _)
  obtain ⟨e, he⟩ := exists_univBasis_of_fibre abelianSchemeLaws_all.2 S (Sp (FractionRing V)) t.G t.PP.L hL P _ α hp hw
