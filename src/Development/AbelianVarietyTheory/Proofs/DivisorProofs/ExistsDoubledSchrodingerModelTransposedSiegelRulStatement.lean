theorem exists_GA_of_UG (V : HSp D)
    (p : GlobalTheory.WeilM.UG (GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.cA D.sp.cm.sig) (incM D.host.F V.gramᵀ)) :
    ∃ h : GA D V, mt V h = p.1.1 := by
