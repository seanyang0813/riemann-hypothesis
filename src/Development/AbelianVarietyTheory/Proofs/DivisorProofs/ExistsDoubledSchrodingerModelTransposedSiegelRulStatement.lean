theorem isAddFundamentalDomain_blocks (e : G ≃ᵐ H × H) (he : ∀ x y, e (x + y) = e x + e y)
    (Γ : AddSubgroup G) (Λ : AddSubgroup H) (h1 : ∀ g ∈ Γ, (e g).1 ∈ Λ) (h2 : ∀ g ∈ Γ, (e g).2 ∈ Λ)
    (h3 : ∀ a ∈ Λ, ∀ b ∈ Λ, e.symm (a, b) ∈ Γ) (μ₁ : Measure H) [SigmaFinite μ₁] (𝓕₁ : Set H)
