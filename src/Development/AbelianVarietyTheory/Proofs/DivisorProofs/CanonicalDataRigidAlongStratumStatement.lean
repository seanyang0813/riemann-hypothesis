  obtain ⟨e₁, he₁, f₁⟩ := grpPullback_iso c₁ (isGrpPullback_pullback B₀ (spMap (ρ.comp ιb)))
  obtain ⟨e₂, he₂, f₂⟩ := grpPullback_iso c₂ (isGrpPullback_pullback B₀ (spMap (ρ.comp ιb)))
  let I := RingHom.ker (TrivSqZeroExt.fstHom k k k).toRingHom
