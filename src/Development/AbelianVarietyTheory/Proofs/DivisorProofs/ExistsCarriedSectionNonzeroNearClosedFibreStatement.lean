    {φ : K → (Y ⟶ X)} {ε : K → ℤ} (s : LB.Sec (LB.LinComb L φ ε)) (ρ : Y₀ ⟶ Y)
    (h : ∀ (y : Y₀) J, Good L y J → sval s ρ y J = 0) (j : K → L.ι) :
    (ρ.app (LB.wchart L φ j)).hom (s.f j) = 0 := by
