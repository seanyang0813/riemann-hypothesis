theorem exists_inv_zero {I : Ideal R} (D : DegData R I) :
    ∃ Φ : LB.Sec (LB.LinComb D.toPre.P.L (Y := Spec (CommRingCat.of R)) (K := PUnit) (fun _ => (D.toPre.c 0).left)
      (fun _ => - -1)),
