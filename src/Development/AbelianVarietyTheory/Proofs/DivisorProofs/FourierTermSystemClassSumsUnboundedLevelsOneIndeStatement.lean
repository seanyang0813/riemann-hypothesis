theorem one_apply {A B : Type} [AddCommGroup A] [AddCommGroup B] (K : (Fin 1 → A) ≃+ (Fin 1 → B)) (x : A) :
    one K x = K (fun _ => x) 0 := rfl

theorem apply_eq_one {A B : Type} [AddCommGroup A] [AddCommGroup B] (K : (Fin 1 → A) ≃+ (Fin 1 → B)) (κ : Fin 1 → A) :
