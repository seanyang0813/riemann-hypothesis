    apply mul_right_cancel₀ (hb x hx)
    rw [← gs_mul _ _ _ hx, ← gs_mul _ _ _ hx, _root_.mul_assoc, ← hw, ← hw', _root_.one_mul]
  exact ⟨⟨w, w', (mul_comm _ _).trans e, e⟩, hw⟩

