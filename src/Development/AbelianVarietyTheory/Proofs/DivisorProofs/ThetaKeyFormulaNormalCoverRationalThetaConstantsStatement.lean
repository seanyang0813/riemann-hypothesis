  obtain ⟨i, hi⟩ := Semi.LB.mem_of_cover (ProjSpace.O1_isLB o 0) x
  obtain rfl : i = (0 : Fin 1) := Subsingleton.elim (α := Fin 1) _ _
  exact hi

theorem cls_det_zero {X : Scheme.{0}} (F : X.Modules) (h : (VB.det F 0).IsLB) : CechPic.cls _ h = 0 := by
