  obtain ⟨f, hloc, hcomp⟩ := _root_.GlobalTheory.KeyValsGen.keyVals κ hH hF S t.G g t.PP δ σ hg hN hn h0 t.semi hsm hne hop t.sym hδ hpol hnz
    (fun A _ _ _ _ _ ξ hξ _ L' σ' x y hiso hsm' hop' hsym' hpol' hy hσ' hk =>
