  intro κ hR4
  obtain ⟨hHom, hFun, hTh1, hFamU⟩ := id hR4
  intro V _ _ _ _ hcomp D x G _ _ hSA U w₀ hNW y hy hyv C _ _ _ _ _ _ hCE hiso N ν hInt th ϑ c hOn hExp hFV
