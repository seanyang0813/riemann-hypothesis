  obtain ⟨c', hcu'⟩ := mem_range_of_small_traits hA f hf0 ((u⁻¹ : (Localization.Away f)ˣ) : Localization.Away f)
    (fun V _ _ _ hV hcV a ha => by
      obtain ⟨W, _, _, g, h1, h2, h3⟩ := trait V hV hcV a ha
