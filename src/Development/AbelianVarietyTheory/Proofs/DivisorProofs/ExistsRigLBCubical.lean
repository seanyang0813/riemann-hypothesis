  rw [map_mul, map_mul, map_mul, counitLeft_map_comul, counitLeft_assoc_symm_map_comul,
    counitLeft_assoc_symm_tmul, Bialgebra.counit_one, one_smul, Algebra.TensorProduct.map_tmul,
    AlgHom.id_apply, mul_comm] at h
