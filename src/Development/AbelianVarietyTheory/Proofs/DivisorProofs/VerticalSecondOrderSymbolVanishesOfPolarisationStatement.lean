theorem backTop_ι : backTop U hU ≫ U.ι = 𝟙 X := IsOpenImmersion.lift_fac _ _ _

theorem backTop_apply (y : X) : U.ι (backTop U hU y) = y :=
  congrArg (fun g : X ⟶ X => g y) (backTop_ι U hU)

instance : IsIso (backTop U hU) :=
