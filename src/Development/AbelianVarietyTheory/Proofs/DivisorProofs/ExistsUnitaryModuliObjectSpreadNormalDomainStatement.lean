  obtain ⟨r₀, hr₀, v₀⟩ := GlobalTheory.LieLoc.lie_locally_free A G d hd ⟨RingHom.ker g₀, RingHom.ker_isPrime g₀⟩
  have h₀r : g₀ r₀ ≠ 0 := fun e => hr₀ (RingHom.mem_ker.2 e)
