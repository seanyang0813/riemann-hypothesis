  let Bd : Submodule Γ(X, U.1) (∀ p : J × J, Γ(t.G.left, W p.1 ⊓ W p.2)) :=
    { carrier := {x | ∃ h : ∀ i : J, Γ(t.G.left, W i), ∀ i i',
