      rw [← MonObj.comp_pow, Over.comp_left, htu]; simp
    have hxs : (xp ^ l.M').left ≫ o'.t.G.hom = 𝟙 _ := by simpa using Over.w (xp ^ l.M')
    have h₁ := hpts _ (e.symm y) hxs hxa
