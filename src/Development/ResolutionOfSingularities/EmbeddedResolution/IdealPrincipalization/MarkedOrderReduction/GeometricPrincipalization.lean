    orderAt_boundary_eq_one := hR.orderAt_boundary_eq_one
    sUnion_isOpen := by
      intro T hT J 𝒞 h𝒞
      exact FunctorialResolution.EmbeddedResolution.isOpen_preimage_sUnion_intersectionComponents T hT J (hR.stratum_smooth T hT J) 𝒞 h𝒞
    withBoundary_valid := by
