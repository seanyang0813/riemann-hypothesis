theorem lev_comp {lev : Fin n → ℕ} (hlev : Monotone lev) {L : Fin n → ℤ} (hL : StrictAnti L)
    (σ : Equiv.Perm (Fin n)) (T : Finset (Fin n × Fin n)) (hT : T ⊆ prs n)
    (hs : ∀ a, score T a = score (tZero lev) a + 2 * (L a - L (σ a))) (a : Fin n) :
