  by_contra hc
  have hu0 : u a₀ = 0 := by simp [hu, hw, hc]
  have hw0 : w a₀ = 1 := by simp [hw, hj]
  rw [hu0, hw0] at hz₀
  have := hin a₀ le_rfl
  simp only [sub_zero, one_mul] at hz₀
