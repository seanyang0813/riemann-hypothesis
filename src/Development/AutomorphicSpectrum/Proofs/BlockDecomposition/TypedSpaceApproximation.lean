    (ν : Measure Y) (b : Y → ℝ≥0∞) (hb : Measurable b) (hmass : ∫⁻ y, b y ∂ν = 1)
    (k : Y → G) (hk : Continuous k) (f : G → ℂ) (hf : Continuous f)
