  have hcl := hclose (fun v =>
    (coordW (Fv F v) b (lam v) 1 M (sA b v a ∩ {X | qF (Fv F v) σ J X ∈ V v})).toReal /
      (lam v (V v)).toReal) (fun v _ => by
