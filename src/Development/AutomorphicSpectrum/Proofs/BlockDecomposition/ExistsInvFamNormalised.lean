  funext g
  obtain ⟨a, -, t, i, hi, rfl⟩ := _root_.GlobalTheory.CompanionTheory.TameDecomp.exists_frob_pow_mul_pow_mul_inertia F Ω A v hA φ hφ₁ N hN g
