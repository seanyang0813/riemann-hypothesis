        GlobalTheory.AllWt.conjEmb_conjEmb τ.1
      have hσ : σ ≠ τ.1 := fun e => h (e ▸ τ.2)
      by_cases e : σ = ComplexEmbedding.conjugate τ.1
      · rw [f1 _ _ (Subtype.ext (by show conjEmb σ = τ.1; rw [e]; exact hcc))]
