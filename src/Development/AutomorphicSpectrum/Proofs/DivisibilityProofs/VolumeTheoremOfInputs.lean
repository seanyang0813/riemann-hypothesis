    · intro L hL
      have hE' : ∀ i, L i = H ∨ ∃ a, L i = (Re.line a t).tensor H ∨ L i = (Re'.line a t).tensor H := by
        intro i
        rcases hL i with h | h
        · exact Or.inl h
        · obtain ⟨r, e | e⟩ := hEE i
          · exact Or.inr ⟨w r, Or.inl (by rw [h, e])⟩
          · exact Or.inr ⟨w r, Or.inr (by rw [h, e])⟩
      have hLs : ∀ j, IsSmoothHerm (L j) := by
