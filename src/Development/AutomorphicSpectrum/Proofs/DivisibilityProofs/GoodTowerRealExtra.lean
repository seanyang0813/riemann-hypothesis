      show ‖κ ((a * b : 𝓞 F) : F)‖ < 1
      have h1 : ‖κ (a : F)‖ ≤ 1 := by
        have := HT.LatBasic.val_le_one (NormedField.valuation (K := ℂ_[p])) κ a
        exact_mod_cast this
