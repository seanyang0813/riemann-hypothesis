    exact hφ j
  | zero => simp
  | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
  | smul a x _ hx =>
    rw [Subring.smul_def, map_smul, smul_eq_mul]
    exact mul_mem a.2 hx

