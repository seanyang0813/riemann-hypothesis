    ⟨IsUnit.mk0 _ ((map_ne_zero_iff _ hg).2 hu.1), hu.2⟩
  rw [← finrank_of_lieMult MW h1 h, ← h4, finrank_span_eq_card h3, Fintype.card_fin]

