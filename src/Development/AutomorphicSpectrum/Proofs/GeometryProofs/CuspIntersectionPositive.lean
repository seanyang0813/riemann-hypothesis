    calc L y = L (∑ t : E →+* ℂ, eigComp R.B (t.comp (algebraMap (𝓞 E) E)) y) := by rw [h2 y]
      _ = Ls (∑ t : E →+* ℂ, eigComp R.B (t.comp (algebraMap (𝓞 E) E)) y) := by

        rw [map_sum, map_sum]
        exact Finset.sum_congr rfl fun t _ => key t _ ((h1 _).1 y)
