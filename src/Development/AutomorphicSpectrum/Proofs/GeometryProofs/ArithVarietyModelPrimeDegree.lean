def locAt (Ω : Type) [Field Ω] [Algebra R Ω] (𝔮 : Ideal R) [h : 𝔮.IsPrime] : Subalgebra R Ω where
  carrier := {x | ∃ u v : R, v ∉ 𝔮 ∧ x * algebraMap R Ω v = algebraMap R Ω u}
