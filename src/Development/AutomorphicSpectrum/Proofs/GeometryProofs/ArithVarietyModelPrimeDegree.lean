    pt_inj := fun s t x y h => b.injective (Γ.pt_inj _ _ x y h)
    pt_onto := fun g hg => by
      obtain ⟨t, x, h⟩ := Γ.pt_onto g hg
      obtain ⟨s, rfl⟩ := b.surjective t
      exact ⟨s, x, h⟩ }

theorem exists_mulEquiv {A B C : Type} [Group A] [Group B] [Group C] (f : A →* B) (g : A →* C)
