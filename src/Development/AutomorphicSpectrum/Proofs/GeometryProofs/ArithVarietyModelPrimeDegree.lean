  have h0 : algebraMap R Ω v ≠ 0 := fun e => hv (by
    have : v = 0 := hinj (by rw [e, map_zero])
    rw [this]; exact 𝔮.zero_mem)
  exact ⟨h0, 1, v, hv, by rw [inv_mul_cancel₀ h0, map_one]⟩

