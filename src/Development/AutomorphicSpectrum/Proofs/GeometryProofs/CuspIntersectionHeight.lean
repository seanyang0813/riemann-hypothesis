  exact ⟨Nat.cast_ne_zero.2 hp, ⟨(p : X.presheaf.stalk (centre zL)), map_natCast _ _⟩,
    GlobalTheory.CompanionTheory.Ar.RootHt.inv_mem_regAt_of_isUnit h hv (isUnit_iff_ne_zero.2 (Nat.cast_ne_zero.2 hp))⟩

