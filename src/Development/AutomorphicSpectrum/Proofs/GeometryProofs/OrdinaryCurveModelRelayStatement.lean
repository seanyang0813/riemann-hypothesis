    (hb' : Submodule.span Ω (Set.range b) = 𝔐.Vgen t) :
    (∀ z : Fin r → C,
      z ∈ spanOver RC (bcMap Ω C _ '' dotDual (CR O y c') (coordLat O y (𝔐.dR t) b c')) ↔
