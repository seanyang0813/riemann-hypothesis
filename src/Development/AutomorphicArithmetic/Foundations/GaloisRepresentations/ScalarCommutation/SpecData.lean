  refine finsum_congr fun h => ?_
  simp [Prod.mk_mul_mk]

private theorem op_eig {p : ℕ} [Fact p.Prime] {G : HTGroup p} {V Γ : Type} [AddCommGroup V] [Module ℂ V] [Group Γ]
