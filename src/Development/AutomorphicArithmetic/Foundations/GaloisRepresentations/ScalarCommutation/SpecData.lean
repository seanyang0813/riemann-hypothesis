  rw [h2]
  ext i j
  by_cases hij : i = j
  · subst hij; simp [Matrix.algebraMap_matrix_apply]
  · simp [Matrix.algebraMap_matrix_apply, hij]

private theorem gram_psi (A : Arith E) (n : ℕ) (τ : E →+* ℂ) (b : Matrix (Fin n) (Fin n) E) (hb : Dg A n * b = 1) :
