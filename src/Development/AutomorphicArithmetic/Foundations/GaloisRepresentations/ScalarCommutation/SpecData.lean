      simp only [SetLike.mem_coe, MonoidHom.mem_ker, Set.mem_preimage, Set.mem_ofPred_eq, h]
    rw [e]
    exact V.ker_open.preimage hc
  · intro σ v hv hσ
    obtain ⟨σ', e, he, hcusp⟩ := hC E n w₀ σ
