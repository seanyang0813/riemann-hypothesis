private theorem exists_unit {E : Type} [Field E] [NumberField E] (P : HeightOneSpectrum (𝓞 E)) :
    ∃ u : (FiniteAdeleRing (𝓞 E) E)ˣ, Valued.v ((u : FiniteAdeleRing (𝓞 E) E) P) = WithZero.exp (-1 : ℤ) ∧
      ∀ Q, Q ≠ P → (u : FiniteAdeleRing (𝓞 E) E) Q = 1 := by
