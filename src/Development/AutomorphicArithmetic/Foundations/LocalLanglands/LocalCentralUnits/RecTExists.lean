  have hMφ : M.map φ = (k0 : Matrix (Fin n) (Fin n) k) := by
    ext a b
    exact i.apply_symm_apply _
  have hM'φ : M'.map φ = ((k0⁻¹ : GL (Fin n) k) : Matrix (Fin n) (Fin n) k) := by
    ext a b
    exact i.apply_symm_apply _
  have hMM : M * M' = 1 := by
    apply Matrix.map_injective hφ
    show (M * M').map φ = (1 : Matrix (Fin n) (Fin n) ℤ_[g]).map φ
