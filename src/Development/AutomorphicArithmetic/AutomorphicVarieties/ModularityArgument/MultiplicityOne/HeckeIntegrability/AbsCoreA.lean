private theorem relIndex_positions {G ι : Type} [Group G] {A : ι → Type} [∀ i, Group (A i)] (K : Subgroup G)
    (q : ∀ i, G →* A i) (j : ∀ i, A i →* G) (B N : ∀ i, Subgroup (A i)) (T : Finset ι)
