    rw [InvT.chiDet_invT]
    exact Units.mul_inv _
  cases o with
  | fin k =>
    have := key (GlobalTheory.CuspRep.finGL E a k)
    rw [← InvT.finGL_invT] at this
    exact this
  | cpt k =>
    have := key (infGL E a (Unitary.toUnits k))
