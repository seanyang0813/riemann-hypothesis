  have dm : ∀ {k : ℕ} (J : Matrix (Fin k) (Fin k) E), J.det ≠ 0 → (J.map (B.τ v)).det ≠ 0 := fun J hJ => by
    have : (J.map (B.τ v)).det = B.τ v J.det := (RingHom.map_det (B.τ v : E →+* Fv F v) J).symm
