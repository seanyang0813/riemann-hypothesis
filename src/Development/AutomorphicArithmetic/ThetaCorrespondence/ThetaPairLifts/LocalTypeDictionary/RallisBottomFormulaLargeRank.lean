  have e3 : ((y * k, g) : Formalism.L2.Theta.GA D A × Formalism.L2.Theta.GA D WW) = (y, g) * (k, 1) := by
    rw [Prod.mk_mul_mk, mul_one]
  rw [e2, e2, e3, map_mul, Module.End.mul_apply, move, hf]

