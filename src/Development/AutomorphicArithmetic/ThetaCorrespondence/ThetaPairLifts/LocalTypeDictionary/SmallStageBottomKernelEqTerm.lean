    refine ⟨κ, hκ, fun hS hT e0 he _ => ?_⟩
    subst hS hT
    obtain ⟨ζ, hζ, e⟩ := GlobalTheory.T.normalisedVacua_ratio_algebraicUnit_everyPrime hI hset.crv ht he h1
    exact ⟨ζ, hζ, by rwa [mul_smul, ← e]⟩
  · refine ⟨1, one_ne_zero, fun hS hT e0 he h0 => ?_⟩
    subst hS hT
