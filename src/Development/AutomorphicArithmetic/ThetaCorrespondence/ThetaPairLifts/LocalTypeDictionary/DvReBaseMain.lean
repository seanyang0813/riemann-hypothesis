  obtain ⟨f, hf, rfl⟩ := Submodule.mem_map.1 hx'
  rw [← h] at hf
  exact hx (LinearMap.mem_ker.1 (Submodule.mem_inf.1 hf).1)

theorem le_ker_of_ge {P : Type} [AddCommGroup P] [Module ℂ P]
