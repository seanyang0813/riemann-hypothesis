      equivLie := fun τ _ X _ _ _ _ => (Formalism.IndefR.Mult.rder_zero θ V τ X).symm
      other := fun _ _ _ _ => (smul_zero _).symm }
  add_mem' := by
    intro F G hF hG
    refine ⟨fun u => A.add_mem (hF.mem u) (hG.mem u), fun τ hτ g hg hk u w hw => ?_,
