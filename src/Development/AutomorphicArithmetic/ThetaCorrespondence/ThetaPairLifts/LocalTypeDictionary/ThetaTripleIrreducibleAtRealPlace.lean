    (T T' : Module.End ℂ (P ⊗[ℂ] GlobalTheory.SmallThetaModules.RTens fun v => pv v (m v)))
    (h : ∀ f ∈ S, ∀ φ : ∀ v, V v, (∀ v, φ v ∈ SV v) → (∀ᶠ v in Filter.cofinite, φ v = m v) →
      T (pr f ⊗ₜ GlobalTheory.SmallThetaModules.pureT _ fun v => pv v (φ v)) =
