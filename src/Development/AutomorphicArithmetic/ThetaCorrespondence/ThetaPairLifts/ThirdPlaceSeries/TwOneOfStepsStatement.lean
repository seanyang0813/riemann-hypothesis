  · obtain ⟨n, hn⟩ := hψ.ord
    refine forall₂_congr fun x hx => ?_
    have h3 : ψ.loc v x ^ (l ^ n) = 1 := by
      rw [← loc_pow, show ψ ^ (l ^ n) = 1 from hn]
