theorem not_unr (hδ : IsDelta q δ) (hψ : IsPsi l Q ψ) (hl : l.Prime) (a : ℕ) {v : Pl D.host.E}
    (hv : (q : 𝓞 D.host.E) ∈ v.asIdeal) : ¬ (δ * ψ ^ a).UnrAt v := fun hu => by
