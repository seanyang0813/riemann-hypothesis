  have h : q.e * q.sec x = q.sec x := by rw [← q.sec_pr, q.pr_sec]
  have h2 := q.sec_pr (a * q.sec x)
  rw [map_mul, q.pr_sec, mul_left_comm, h] at h2
  exact h2.symm

