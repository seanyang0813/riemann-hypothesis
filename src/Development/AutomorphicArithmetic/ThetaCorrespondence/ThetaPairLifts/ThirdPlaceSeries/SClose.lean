  obtain ⟨logJacobianTwoPoints, B2, j2, E2⟩ := W.above l ι ρ' w hw
  obtain ⟨ColumnLift, B3, j3, E3⟩ := W.above l ι (Formalism.MainNotions.SumRepresentations.At.sumRep ρ ρ') w hw
