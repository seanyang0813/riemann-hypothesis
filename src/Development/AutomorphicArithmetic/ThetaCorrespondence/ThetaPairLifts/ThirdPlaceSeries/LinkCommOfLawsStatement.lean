      rw [Complex.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, hχ]; simp
    simp only [L1.2.1 k hk κ hκ, L2.2.1 k hk κ hκ, star_mul']
    linear_combination (rdS θ V rfl S yc φ y x * star (rdS θ V rfl S yc ψ y x)) * h1

