theorem inv_block (q : ℕ) (z : ℂ) (t : ℕ) :
    (((List.range t : List ℕ) : Multiset ℕ).map
        fun k : ℕ => z⁻¹ * (q : ℂ) ^ (((((t : ℝ) - 1) / 2 - k : ℝ)) : ℂ)).map (fun a : ℂ => a⁻¹) =
