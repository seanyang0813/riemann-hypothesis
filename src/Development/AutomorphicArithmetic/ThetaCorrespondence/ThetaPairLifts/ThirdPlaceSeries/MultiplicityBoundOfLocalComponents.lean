  have hρ : RhoSpec D' A'.row rowS := _root_.UpperTheory.galoisRep_transport_of_copyAll_alt hArt h hf hCS Rw jE' A' hRC hG hCh Sb Sb' eig In.eig hT hT' S S' B.cHk c hc
