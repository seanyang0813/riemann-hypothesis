  have hS : ∀ i, In.Sb ⊆ D'.ntw.S0 i := hSb.subset_twistExceptionalPlaces subset_rfl Rp.tw
  have hP : PsiLaw D' S' In.θ := psi_law_transfer h hψ hψ' B.psiU
