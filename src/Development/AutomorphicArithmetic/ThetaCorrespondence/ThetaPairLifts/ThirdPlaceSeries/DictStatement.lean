    exact _root_.GlobalTheory.TSetFinCong.finite_image_tSet_cong D.host.E D.R.nV (P.M.loc i).J ⟨N, hN, fun κ hκ => (hNJ κ hκ).1⟩ sp ϖ k hϖ
