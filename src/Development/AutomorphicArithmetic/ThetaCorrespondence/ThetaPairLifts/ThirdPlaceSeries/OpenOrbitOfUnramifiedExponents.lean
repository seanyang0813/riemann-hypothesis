    refine iSup₂_le fun Φ hΦ => ?_
    rintro _ ⟨f, rfl⟩
    rw [Submodule.mem_comap, ← hΦ.1 h f]
    exact (le_iSup₂ (f := fun (Φ : π.S →ₗ[ℂ] A) (_ : principalLevelFrame.IsEqvA ρ π Φ ∧ LinearMap.range Φ ≤ C) => LinearMap.range Φ) Φ hΦ)
      ⟨_, rfl⟩
  exact key hz

