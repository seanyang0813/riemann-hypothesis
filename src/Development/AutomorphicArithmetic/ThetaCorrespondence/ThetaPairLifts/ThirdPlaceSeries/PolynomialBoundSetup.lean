      have hcast : ((((D.R.t : ℚ) - 1 - a) - c0 D : ℚ) : ℝ) = (D.R.t : ℝ) - 1 - a - ((D.R.t : ℝ) - 1) / 2 := by
        push_cast [hc0]; ring
      rw [hcast, hzR] at hq
