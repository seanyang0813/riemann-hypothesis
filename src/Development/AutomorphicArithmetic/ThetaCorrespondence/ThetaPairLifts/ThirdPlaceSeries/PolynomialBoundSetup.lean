      rw [e] at hq
      have hcast : (((D.R.t : ℚ) - 1 - a : ℚ) : ℝ) = (D.R.t : ℝ) - 1 - a := by push_cast; ring
      rw [hcast, hc0] at hq
      have key : a ≤ -2 ∨ (D.R.t : ℤ) + 1 ≤ a := by
        rcases hq with ⟨-, h⟩ | ⟨h, -⟩
        · right
          have : ((D.R.t : ℤ) - 1 - a : ℚ) ≤ -2 := by push_cast; linarith
