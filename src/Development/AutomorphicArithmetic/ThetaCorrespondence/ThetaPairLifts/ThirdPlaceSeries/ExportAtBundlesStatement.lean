variable {Λ Λ' : Type} [CommRing Λ] [CommRing Λ'] [Algebra (X.O0 i) Λ] [Algebra (X.O0 i) Λ'] (π : Λ →ₐ[X.O0 i] Λ')
  {κ : GE N →* Λˣ} {κ' : GE N →* Λ'ˣ} (hκ : ∀ g, π (κ g : Λˣ) = (κ' g : Λ'ˣ)) {r : ℕ} (ρ : GE N →* GL (Fin r) (X.O0 i))
