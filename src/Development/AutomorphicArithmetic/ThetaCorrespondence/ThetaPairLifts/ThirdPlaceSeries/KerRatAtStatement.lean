  have hi : IsIntegral ℤ D.host.sqrtMinusD := IsIntegral.of_pow two_pos (by
    rw [hs]
    exact (isIntegral_natCast _).neg)
  obtain ⟨b, hb⟩ : ∃ b : 𝓞 D.host.E, b ^ 2 = -((D.host.d : ℕ) : 𝓞 D.host.E) :=
