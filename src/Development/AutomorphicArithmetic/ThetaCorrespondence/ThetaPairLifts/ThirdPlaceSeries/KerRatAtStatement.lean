    {h : GA D (Vc D j)} (hh : h ∈ GfC (Vc D j)) {y : (Rl.cV j).W} (hy : InCoefLat Rl.toRealDat j h y)
    (u : ∀ τ, lowT (Rl.MW j (sg0 D A3.A)) τ) (hu : ∀ τ, (u τ : (Rl.MW j (sg0 D A3.A)).sm τ) = v₀ j (sg0 D A3.A) τ) :
