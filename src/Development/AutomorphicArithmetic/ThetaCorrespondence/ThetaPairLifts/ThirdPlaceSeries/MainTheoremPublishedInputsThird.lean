  have hr0 : (0 : ℝ) ≤ (D.R.r : ℝ) ^ 19 := by positivity
  refine ⟨hr, fun τ j hj => ?_⟩
  have := GlobalTheory.Core.Rk.HdGap.gap_of HL τ j.1 hj
  simp only [Fin.eta] at this
  have key : (((16 : ℚ) * (D.R.r : ℚ) ^ 19 : ℚ) : ℝ) ≤
      (((D.hc τ).b ⟨j.1 + 1, hj⟩ - (D.hc τ).b j : ℚ) : ℝ) := by
