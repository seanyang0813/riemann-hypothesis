  rintro ⟨w', hover, hw'⟩
  rcases GlobalTheory.SplitConjPlace.eq_or_eq_conjPlE w w' (hover.trans hov.symm) with e | e
  · subst e
    rcases hw' with hQ | ⟨k, hg⟩ | hpd
    · exact hnQ hQ
    · exact hng k hg
    · exact hnp' hpd
  · subst e
    rcases hw' with hQ | ⟨k, hg⟩ | hpd
    · exact hnQ (P.H.hecke.Q_conj i _ w (isConjPl_conjPlE_left w) hQ)
