    obtain ⟨S₀, hS₀⟩ := _root_.GlobalTheory.CoefField.entries_mem_of_finset l E Ω a ρ₀ hc₀
    refine ⟨S₀.image ι, fun K hK ρ hc hs hp => ?_⟩
