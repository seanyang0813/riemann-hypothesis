  have := Thom.HtpyMVPf.sch_pres
  exact (isPullback_opens_inf_le (X := X) (le_sup_left : U ≤ U ⊔ V) (le_sup_right : V ≤ U ⊔ V)).map sch

end Sq

def res (q : ℕ) (i n : ℤ) {X : Scheme.{0}} {U W : X.Opens} (h : U ≤ W) :
