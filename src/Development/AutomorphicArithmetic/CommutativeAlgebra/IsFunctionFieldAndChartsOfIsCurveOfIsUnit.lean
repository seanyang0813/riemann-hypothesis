def rDiff (q : ℕ) (i n : ℤ) {X : Scheme.{0}} {U V W P : X.Opens} (c : Sq U V W P) :
    Ht q (sch.obj U) n i × Ht q (sch.obj V) n i →+ Ht q (sch.obj P) n i :=
