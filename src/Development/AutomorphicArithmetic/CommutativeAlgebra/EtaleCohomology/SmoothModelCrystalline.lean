    (hε : PreTilt.untilt ε = 1) : ACris.ACris F p →+* ACris.BCris hε :=
  (algebraMap (ACris.BCrisPlus F p) (ACris.BCris hε)).comp
    (algebraMap (ACris.ACris F p) (ACris.BCrisPlus F p))

