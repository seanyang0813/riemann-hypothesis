  show spanForms {c | c * (t : X.functionField) ∈ locRing y} _ a ≤ spanForms {c | D.RegularAt y c} _ a
  rw [hM]
  refine spanForms_le_of_mem_closure_smul _ (locRing y) (fun c hc b hb => ?_) _ _ ?_ a
  · show c * b * (t : X.functionField) ∈ locRing y
