private theorem exists_unitAt_dK_eq_smul_dlog_of_regAt {X : Scheme.{0}} [IsIntegral X] {y : X} {a : X.functionField} (ha : RegAt y a) :
    ∃ u : X.functionFieldˣ, UnitAt y (u : X.functionField) ∧ ∃ b, RegAt y b ∧ dK a = b • dlog u := by
