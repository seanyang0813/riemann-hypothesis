  have h2 : a ≤ (a.toNat : ℤ) := Int.self_le_toNat a
  exact hA h2 (hn _)

theorem block_of_ne [IsDomain BdR] {τ : K →ₐ[Qp] LL} {κ : K →ₐ[Qp] Om}
    (hK : ∀ c : K, algebraMap K BdR c = algebraMap Om BdR (κ c))
    {f : (LL →ₐ[Qp] Om) → BdR} (hE : IsE (τ := τ) (Om := Om) (BdR := BdR) f) {σ : LL →ₐ[Qp] Om}
