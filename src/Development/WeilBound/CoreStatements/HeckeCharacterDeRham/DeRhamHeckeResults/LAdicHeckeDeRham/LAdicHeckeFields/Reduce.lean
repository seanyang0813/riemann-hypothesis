    (hρ : ∀ g v, ρ g v = ((χ g : LLˣ) : LL) • v) (hρ' : ∀ g v, ρ' g v = ((χ' g : LLˣ) : LL) • v)
    (hχ : ∀ g, (χ g : LL) * (χ' g : LL) = 1) (τ : K →ₐ[Qp] LL)
