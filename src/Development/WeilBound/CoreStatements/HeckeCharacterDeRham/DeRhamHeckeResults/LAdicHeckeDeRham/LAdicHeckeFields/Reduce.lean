  · rintro ⟨y, rfl⟩ σ
    induction y using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy =>
      simpa only [map_add] using Submodule.add_mem (PD.Fil a) hx hy
    | tmul v c =>
