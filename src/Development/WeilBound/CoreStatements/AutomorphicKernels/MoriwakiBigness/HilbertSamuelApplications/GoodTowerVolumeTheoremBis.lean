  have hinj := algebraMap_injective (Ω := Ω) (A := A) (m := m) (O := O)
  haveI : CharZero Ω := charZero_of_injective_ringHom 𝔐.cst.injective
  obtain ⟨ζ, hζ⟩ := exists_root 𝔐 hpq hp hpS
