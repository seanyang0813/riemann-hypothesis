  intro Ω _ O _ _ R _ L _ _ _ _ Li _ _ toLi hb
  exact ⟨hb.toDual, PositivityTheory.Xgn.DualBaseChange.dual_isBaseChange hb,
    fun u v => hb.toDual_comp_apply u v⟩
end -- clump:auto
