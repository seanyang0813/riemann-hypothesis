    have := (IsLocalRing.residue_eq_zero_iff (p : O)).2 hpm'
    simpa using this
  obtain ⟨inc, hinc⟩ := exists_hom (A := A) (m := m) (O := O) (𝔐.cst.comp (algebraMap (𝓞 c.F) c.F))
