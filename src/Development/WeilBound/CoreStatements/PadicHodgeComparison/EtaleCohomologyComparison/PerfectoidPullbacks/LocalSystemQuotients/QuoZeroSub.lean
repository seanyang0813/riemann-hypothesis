theorem prism_tele {A : Type*} [AddCommGroup A] (m : ℕ) (X : Fin (m + 1) → Fin (m + 2) → A)
    (h1 : ∀ i : Fin m, X i.succ i.succ.castSucc = X i.castSucc i.castSucc.succ) :
