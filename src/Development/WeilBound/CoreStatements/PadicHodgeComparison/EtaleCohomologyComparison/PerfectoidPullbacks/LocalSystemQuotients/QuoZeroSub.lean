theorem prism_cancel {A : Type*} [AddCommGroup A] (n : ℕ) (X : Fin (n + 2) → Fin (n + 1) → A)
    (Y : Fin (n + 2) → Fin (n + 1) → A) (h : ∀ i l, X i l = Y (i.succAbove l) (l.predAbove i)) :
    ∑ i : Fin (n + 2), ∑ l : Fin (n + 1), (-1 : ℤ) ^ (i : ℕ) • (-1 : ℤ) ^ (skip i l : ℕ) • X i l +
