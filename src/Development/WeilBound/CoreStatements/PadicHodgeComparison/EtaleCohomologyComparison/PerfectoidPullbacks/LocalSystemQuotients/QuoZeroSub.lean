theorem cochain_congr (f : CH.Cn F p) {c c' : ComposableArrows C p} (h : c = c') {X : C}
    (φ : c.obj (Fin.last p) ⟶ X) (φ' : c'.obj (Fin.last p) ⟶ X) (hφ : φ = eqToHom (by rw [h]) ≫ φ') :
