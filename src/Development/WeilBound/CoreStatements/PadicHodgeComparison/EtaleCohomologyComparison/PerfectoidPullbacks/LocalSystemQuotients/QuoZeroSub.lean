def skip {m : ℕ} (i : Fin (m + 1)) (l : Fin m) : Fin (m + 2) := i.castSucc.succAbove (i.succAbove l)

theorem skip_val {m : ℕ} (i : Fin (m + 1)) (l : Fin m) :
