  simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
  refine Eq.trans ?_ (cyl_bot α (s.map g)).symm
  change (cyl α).map (X := ((0 : Fin 2), s.obj x)) (Y := ((0 : Fin 2), s.obj y)) (_, s.map _) = _
  congr 1

