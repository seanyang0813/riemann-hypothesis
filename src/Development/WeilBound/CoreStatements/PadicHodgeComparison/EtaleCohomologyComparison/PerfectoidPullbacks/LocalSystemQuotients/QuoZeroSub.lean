    refine RingHom.ext fun r' => ?_
    obtain ⟨r, rfl⟩ := hg r'
    have h1 : e1.symm (g r) = Ideal.Quotient.mk P r := by
      rw [RingEquiv.symm_apply_eq]; rfl
    have h2 : f' (g r) = h (f r) := RingHom.congr_fun comm r
