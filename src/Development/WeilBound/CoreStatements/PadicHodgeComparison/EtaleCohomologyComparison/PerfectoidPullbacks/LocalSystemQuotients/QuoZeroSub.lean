        ∑ i : Fin (m + 1), ∑ l : Fin m, (-1 : ℤ) ^ (i : ℕ) • (-1 : ℤ) ^ (skip i l : ℕ) • X i (skip i l) := by
  have hi : ∀ i : Fin (m + 1), (-1 : ℤ) ^ (i : ℕ) • ∑ k : Fin (m + 2), (-1 : ℤ) ^ (k : ℕ) • X i k =
      (X i i.castSucc - X i i.succ) +
        ∑ l : Fin m, (-1 : ℤ) ^ (i : ℕ) • (-1 : ℤ) ^ (skip i l : ℕ) • X i (skip i l) := by
