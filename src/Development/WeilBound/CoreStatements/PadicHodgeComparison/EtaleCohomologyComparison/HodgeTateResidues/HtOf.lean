    (hdv : ∀ a : O, a ≠ 0 → ∃ k : ℕ, a ∣ (l : O) ^ k) {s : ℕ} (hs : 1 ≤ s) : TFBase (dividedPowersBot O) l s := by
  have hb : ∀ r, 1 ≤ r → pdP (dividedPowersBot O) r = ⊥ := fun r hr => by
