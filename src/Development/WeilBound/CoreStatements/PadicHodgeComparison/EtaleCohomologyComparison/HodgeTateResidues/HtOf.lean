      simpa using Ideal.mul_mem_left _ x this
    · rw [hb r hr, Ideal.mem_bot] at hx ⊢
      exact (mul_eq_zero.1 hx).resolve_left (Nat.cast_ne_zero.2 hl)
  · obtain ⟨k, u, hu⟩ := hdv n (Nat.cast_ne_zero.2 hn)
    exact ⟨k, u, hu.symm⟩

