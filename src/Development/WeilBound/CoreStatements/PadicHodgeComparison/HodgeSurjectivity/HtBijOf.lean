theorem term_eq (Λ : Lifts q V) {a n : ℕ}
    (f : CH.Cn (Pb.sq ((thFil (smFun Z q) (a : ℤ)).res (inU q V).ι) ((thFil (smFun Z q) ((a : ℤ) + 1)).res (inU q V).ι)) a) (x₀ : Sec q V) (x : Fin a → Sec q V)
