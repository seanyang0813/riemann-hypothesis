  subst e
  exact congrArg (fun z => z.left) (map_one (pushHom h (Over.mk a)))

theorem gr_core {X : Scheme.{0}} {Ω R : Type} [Field Ω] [CommRing R] {x : Sp R ⟶ X} (hx : Mono x)
