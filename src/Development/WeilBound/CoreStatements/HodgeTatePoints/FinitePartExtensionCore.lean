    have c3 := corr_pullGen (U.gt_t e χ) ii.left
    have c4 := corr_pull_comp D.toPre.P.L ((U.gt (e + 1)).t χ) (thickMap R I e G) ii.left _ hthick
    have c5 := corr_pullGen_of_eq ((U.gt e).t χ) ((U.gt e).t_gen χ) (δ ≫ (U.gt e).i).left ii.left
