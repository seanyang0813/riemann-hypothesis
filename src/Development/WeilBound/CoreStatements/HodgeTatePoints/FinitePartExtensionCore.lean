theorem t_torus (g : GtCoord I D e G) (χ : D.X) {Y : Over (Spec (CommRingCat.of (R ⧸ I ^ (e + 1))))}
    (δ : Y ⟶ splitTorus _ D.X) :
    LB.Gen.Corr D.P.L _ _ _ _ (LB.pullGen D.P.L _ _ (g.t χ) (δ ≫ g.i).left)
