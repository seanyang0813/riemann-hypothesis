      have h0 : y.1.2 = 0 := h
      have h1 : PolMatch B G X R Rf y.1.1 y.1.2 := y.2
      change C y.1.1 = 0
      rw [k y.1 ⟨h0 ▸ zero_mem _, h1⟩, comb, f1 _ (h0 ▸ h1), h0, I_zero, smul_zero, smul_zero, add_zero]
  exact ⟨C, C', k, fun Φ Φ' h => hC' ⟨(Φ, Φ'), h⟩⟩

