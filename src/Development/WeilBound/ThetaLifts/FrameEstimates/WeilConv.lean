    · rw [← ThKEst.W.pure_update (v := B.v₁) f hstd]
      exact ThKEst.W.pure_mem f (hg.update (hξ j).1.1)
  obtain ⟨-, p, C, h1, h2, h3⟩ := key
  exact ⟨p, C, h1, h2, fun f g h => by rw [e f]; exact h3 f g h⟩

