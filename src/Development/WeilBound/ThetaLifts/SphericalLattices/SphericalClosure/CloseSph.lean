    obtain ⟨h1, h2⟩ := (mS ψ).1 hψ
    have := h2 1 (USub σ G.W v).one_mem
    rwa [show ((1 : UA σ G.V.J), (1 : UA σ G.W.J)) = 1 from rfl, L.one ψ h1] at this

