  have e : ⇑(χ * ε⁻¹) = fun x => χ x * (ε x)⁻¹ := by
    funext x
    simp
  refine ⟨?_, fun x => ?_⟩
  · rw [e]
    exact hχ.1.mul hε.1.inv
  · rw [e]
    simp only [hχ.2 x, hε.2 x, inv_one, mul_one]

