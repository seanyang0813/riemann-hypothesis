      have e : g⁻¹ = g * (g * g) := by
        apply GlobalTheory.StdUnn.LeftInvSect.mat_inj
        rw [matG_inv (M := blk4 0 (-1) 1 0), matG_mul, matG_mul, hg, submatrix_fromBlocks_mul, submatrix_fromBlocks_mul]
