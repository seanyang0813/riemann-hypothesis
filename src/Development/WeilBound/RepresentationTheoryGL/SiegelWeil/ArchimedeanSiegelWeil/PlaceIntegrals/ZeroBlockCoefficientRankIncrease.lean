        induction i using Fin.cases with
        | zero => simp [consA, zero_mem]
        | succ i => simpa [consA] using hY p i k

theorem pureL_consA {d M n : ℕ} (b : Module.Basis (Fin d) F E) (S : Finset (HeightOneSpectrum (𝓞 F)))
