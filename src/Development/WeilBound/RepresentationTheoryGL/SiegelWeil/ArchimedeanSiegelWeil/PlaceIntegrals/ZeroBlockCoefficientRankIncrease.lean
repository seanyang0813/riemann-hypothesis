  by_cases hY : Y ∈ intOff b S
  · by_cases ha : a ∈ intOff b S
    · rw [Set.indicator_of_mem (hmem.2 ⟨ha, hY⟩), Set.indicator_of_mem hY, Set.indicator_of_mem ha,
