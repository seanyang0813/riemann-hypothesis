      simp only [hV, Pi.one_apply, one_mul]
    · rw [Set.indicator_of_notMem (fun h => ha (hmem.1 h).1), Set.indicator_of_notMem ha, mul_zero]
  · rw [Set.indicator_of_notMem (fun h => hY (hmem.1 h).2), Set.indicator_of_notMem hY, zero_mul]

