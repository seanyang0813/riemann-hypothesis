  · simpa using nonZeroDivisors.ne_zero c.2
  · obtain ⟨y, hy⟩ := hc x hx
    have : algebraMap (𝓞 F) F c * x = algebraMap (𝓞 F) F y := by
      rw [hy, Algebra.smul_def]
    have h2 : Valued.v (algebraMap F (Fv F v) (algebraMap (𝓞 F) F y)) =
