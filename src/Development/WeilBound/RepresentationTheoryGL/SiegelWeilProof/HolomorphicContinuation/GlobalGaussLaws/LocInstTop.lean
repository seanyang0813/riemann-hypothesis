  have hTF : ∀ (P : PX V.rank n) (b : Matrix (Fin n) (Fin n) ℂ) (Nb : GR n),
      (∀ z, aF P b (piT θ τ z) * A Ψ0 z = (ω (ι Nb) (ω x⁻¹ (phiS θ τ fr (cLoc l τ) Ψ0 P))).1 z) →
      ∃ κ : ℂ, (∫ z, aF P b (piT θ τ z) * A Ψ0 z ∂μ = κ * ∫ u, aF P b u) ∧
