    unfold tLoc cLoc pqOf
    rcases lt_or_gt_of_ne (hl0 τ) with h | h
    · right
      refine ⟨?_, ?_, ?_⟩
      · rw [abs_of_neg h]; ring
      · simp [if_neg (not_lt.2 h.le)]
      · simp [if_neg (not_lt.2 h.le)]
    · left
      refine ⟨?_, ?_, ?_⟩
      · rw [abs_of_pos h]
      · simp [if_pos h]
      · simp [if_pos h]
