        (Finset.single_le_sum (fun j _ => abs_nonneg (σi j)) (Finset.mem_univ i))) hz
    show ∑ i, PositivityTheory.PfSWUS.eis ω H (Φi i) g z = PositivityTheory.PfSWUS.eis ω H Φ g z
