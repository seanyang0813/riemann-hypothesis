    unfold PositivityTheory.PfSWUS.eis
    rw [hsect z, cosetSum_finsum _ _ _ _ _ (fun i _ => hσi i z (hz' i) g)]
  have hv : thetaInt ω ν Φ g = ∑ i, thetaInt ω ν (Φi i) g := by
    rw [hΦeq]
