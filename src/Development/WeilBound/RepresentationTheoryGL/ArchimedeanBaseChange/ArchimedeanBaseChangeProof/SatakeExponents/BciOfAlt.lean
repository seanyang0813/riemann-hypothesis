  | cons a s ih =>
    rw [Multiset.sum_cons, Complex.add_im, h a (by simp), ih fun x hx => h x (by simp [hx]), Multiset.card_cons]
    push_cast
    ring

theorem twist_eq_zero {N : ℕ} (hN : 0 < N) {V : Submodule ℂ (Sm E N)} (hV : IsDiscrete V) {z : ℂ} (hz : z.re = 0)
