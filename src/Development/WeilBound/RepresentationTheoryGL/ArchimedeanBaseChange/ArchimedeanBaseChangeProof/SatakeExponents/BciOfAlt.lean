    obtain ⟨φ₁, hφ₁, φ₂, hφ₂, rfl⟩ := hF
    obtain ⟨ψ₁, hψ₁, e₁⟩ := h₁ φ₁ hφ₁
    obtain ⟨ψ₂, hψ₂, e₂⟩ := h₂ φ₂ hφ₂
