theorem sum_trace_eq_zero {N : ℕ} {V : Submodule ℂ (Sm E N)} (hV : IsDiscrete V) (m : (E →+* ℂ) → Multiset ℂ)
    (hm : ∀ τ, HasInfCharGL V τ (m τ)) : ∑ τ, (m τ).sum = 0 := by
  obtain ⟨φ, hφ, h0⟩ := (Submodule.ne_bot_iff _).1 hV.ne_bot
