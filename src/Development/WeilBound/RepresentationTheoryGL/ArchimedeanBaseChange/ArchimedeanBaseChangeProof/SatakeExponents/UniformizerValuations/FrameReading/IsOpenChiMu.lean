    (g : GLw a w × GLw b w) : phiMu h w (μ.loc w) e x y g =
      ((μ.loc w ((-1) ^ (a * b)) : ℂˣ) : ℂ) * ((chiMu μ w a b g : ℂˣ) : ℂ) * phi3 h w e x y g := by
  rw [phiMu, mu_fac, chiMu_apply, mul_assoc]

