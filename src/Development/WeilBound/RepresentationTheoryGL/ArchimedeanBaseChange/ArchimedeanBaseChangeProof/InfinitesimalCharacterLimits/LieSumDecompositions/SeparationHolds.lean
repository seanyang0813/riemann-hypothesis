theorem bnd_supP {K : Set (GA E N)} (hK : IsCompact K) (hK0 : K.Nonempty) {f g : GA E N → ℂ}
    {m₁ m₂ : ℕ → ℝ} (hf : An.Bnd f m₁) (hg : An.Bnd g m₂) :
