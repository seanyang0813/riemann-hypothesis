    refine expTw_holds E (r + s) (mulChi (r + s) (Model.absC E w) φ) (-w) (hU'.1.2 _ hφ') r hr hrN c ?_
    rw [ParabolicProjection.mulChi_absC_neg]
    exact hc
  have hpc' : pE E (r + s) r (c - -w * r * (Module.finrank ℚ E : ℂ)) = 0 := by
