variable {d : GL (Fin n) E} {m : ℕ} {Wof : (Fin m → SignType) → Submodule E (Fin n → E)}

theorem sle_of_le (hiso : ∀ e, IsoStab d (Wof e)) (hu : ∀ W, IsoStab d W → ∃! e, Wof e = W)
