    intro s
    obtain ⟨h₀, h₁, hu⟩ := hD s
    rw [tsum_eq_single h₀ fun h hh => by
      simp [indicator_of_notMem (fun hm => hh (hu h hm))]]
    simp [h₁]
  simp_rw [e2]
  rw [lintegral_inv_eq_self (fun s : T => σ ((s : G) * x))]
  exact hσ.2 x

