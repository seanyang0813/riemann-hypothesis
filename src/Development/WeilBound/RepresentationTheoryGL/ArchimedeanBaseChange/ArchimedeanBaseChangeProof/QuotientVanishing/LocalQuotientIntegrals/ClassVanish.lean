  have h2 : sMeet e e' = e := (hu _ (hiso e)).unique h1 rfl
  intro i hi
  have h3 := congrFun h2 i
  simp only [sMeet] at h3
  by_contra hne
  split_ifs at h3 with hc
  · exact hne hc.symm
  · exact hi h3.symm

theorem orth_of_comp (hiso : ∀ e, IsoStab d (Wof e)) (hmono : ∀ e e', SLe e e' → Wof e ≤ Wof e')
