  have hS : Stb d (A ⊔ B) := stb_sup hA.1 hB.1
  refine ⟨hS, sup_le ?_ ?_⟩
  · exact perpD_flip hA.1 (sup_le hA.2 (perpD_flip hB.1 h))
  · exact perpD_flip hB.1 (sup_le h hB.2)

def Comp {m : ℕ} (e f : Fin m → SignType) : Prop := ∀ i, e i ≠ 0 → f i ≠ 0 → e i = f i

