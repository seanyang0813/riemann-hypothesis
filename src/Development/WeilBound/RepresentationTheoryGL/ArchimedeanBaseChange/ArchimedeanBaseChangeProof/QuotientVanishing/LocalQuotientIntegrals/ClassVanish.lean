    intro γ
    rw [← lintegral_indicator hDm, ← lintegral_mul_left_eq_self _ (γ : T)]
    refine lintegral_congr fun s => ?_
    rw [he]
    by_cases hs : (γ : T) * s ∈ D
    · simp [hs, mul_assoc]
    · simp [hs]
  simp_rw [e1]
  have hm : ∀ γ : Γ₀, AEMeasurable (fun s : T => D.indicator (1 : T → ℝ≥0∞) ((γ : T) * s) *
