theorem stb_inf {d : GL (Fin n) E} {A B : Submodule E (Fin n → E)} (hA : Stb d A) (hB : Stb d B) : Stb d (A ⊓ B) := by
  apply le_antisymm
  · rintro _ ⟨v, hv, rfl⟩
    rw [Matrix.toLin'_apply]
    exact ⟨stb_mem hA hv.1, stb_mem hB hv.2⟩
