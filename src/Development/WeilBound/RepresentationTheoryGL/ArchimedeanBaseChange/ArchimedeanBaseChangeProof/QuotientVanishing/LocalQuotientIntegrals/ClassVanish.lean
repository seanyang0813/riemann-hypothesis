    simpa [m, mul_assoc] using this
  have hset : ∀ i g, m i g = μT ((fun t : T => (t : G) * g) ⁻¹' U i) := by
    intro i g
    have hme : MeasurableSet ((fun t : T => (t : G) * g) ⁻¹' U i) :=
