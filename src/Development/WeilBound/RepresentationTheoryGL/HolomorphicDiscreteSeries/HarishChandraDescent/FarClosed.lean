  have hv : u x ∈ Z := hZ x hx
  have hw : u (u x) ∈ Z := hZ _ hv
  have h1 := hpos (x - (R⁻¹ : ℂ) • u x) (Z.sub_mem hx (Z.smul_mem _ hv))
  have h2 := hpos (u x - (R⁻¹ : ℂ) • u (u x)) (Z.sub_mem hv (Z.smul_mem _ hw))
