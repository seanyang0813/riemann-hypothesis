  rw [hu (u (u x)) (u x)] at h2
  generalize (⟪u x, x⟫_ℂ).re = p at *
  generalize (⟪u x, u x⟫_ℂ).re = a at *
  generalize (⟪u (u x), u x⟫_ℂ).re = q at *
  generalize (⟪u (u x), u (u x)⟫_ℂ).re = b at *
  generalize (⟪u (u (u x)), u (u x)⟫_ℂ).re = r at *
