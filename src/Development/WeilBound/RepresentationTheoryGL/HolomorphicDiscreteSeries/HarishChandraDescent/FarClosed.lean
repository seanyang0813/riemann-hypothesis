theorem smooth_map (T : H →L[ℂ] H) (hT : ∀ g ∈ UJset ε, Commute T (ρ g)) {v : H} (hv : IsSmoothVecU ε ρ v) :
    IsSmoothVecU ε ρ (T v) := by
  letI : NormedAddCommGroup (Matrix (Fin n) (Fin n) ℂ) := Matrix.normedAddCommGroup
